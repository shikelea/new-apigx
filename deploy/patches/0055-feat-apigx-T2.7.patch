--- a/apigx/api/share.go
+++ b/apigx/api/share.go
@@ -74,6 +74,9 @@ func Register(r *gin.RouterGroup, db *gorm.DB) {
 
 	// 可解释路由结果（T2.9）：只读，不写库、不投影
 	r.GET("/route-explain", h.explainRoute)
+	// 应用路由排名（T2.7 生效路径）：把名次写成底座渠道权重。**平台侧动作**——
