diff --git a/apigx/api/share_test.go b/apigx/api/share_test.go
index e4c363f..e7d2960 100644
--- a/apigx/api/share_test.go
+++ b/apigx/api/share_test.go
@@ -1106,3 +1106,48 @@ func TestPlazaCarriesQualitySummary(t *testing.T) {
 	assert.Equal(t, true, first["insufficient"], "没有样本时必须标为样本不足，而不是给出一个看起来可信的数字")
 	assert.Equal(t, float64(0), first["reliability_lower_bound_ppm"])
 }
+
+// 对外标准模型 ID 与介绍：**只有映射已确认时**广场才显示（§8.2）。未确认时显示上游名，
+// 绝不把"候选"当结论 —— 否则客户端会按一个没人确认过的标准 ID 去调用。
+func TestPlazaCanonicalModelOnlyAfterConfirmation(t *testing.T) {
+	env := newTestEnv(t, true)
+	const owner int64 = 9401
+
+	group := &apigxmodel.ShareGroup{OwnerUserID: owner, Name: "目录组", DefaultVisibility: apigxmodel.ShareGroupVisibilityPublic, PublishStatus: 1}
+	require.NoError(t, apigxmodel.CreateShareGroup(env.db, group))
+	baseChannelID := nextBaseChannelID()
+	require.NoError(t, env.db.Create(&basemodel.Channel{Id: int(baseChannelID), Name: "底座目录", Key: "x", Status: common.ChannelStatusEnabled}).Error)
+	channelID := env.createChannel(t, owner, group.ID, baseChannelID)
+
+	// 建供给会自动登记"候选"别名（见 repo_offering.go）
+	rec, body := env.do(t, http.MethodPost, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/offerings", owner,
+		`{"upstream_model_id":"upstream-name-x"}`)
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+	offeringID := int64(body["data"].(map[string]any)["id"].(float64))
+	_, _ = env.do(t, http.MethodPut, "/api/price-rules", owner,
+		`{"scope_type":0,"scope_id":`+strconv.FormatInt(offeringID, 10)+`,"input_usd_per_million":1,"output_usd_per_million":2}`)
+	require.NoError(t, apigxmodel.SubmitModelOffering(env.db, owner, offeringID))
+	require.NoError(t, apigxmodel.PublishModelOffering(env.db, owner, offeringID))
+
+	// 候选阶段：标准 ID 与介绍必须为空
+	_, body = env.do(t, http.MethodGet, "/api/plaza", owner, "")
+	items, _ := body["data"].(map[string]any)["items"].([]any)
+	require.NotEmpty(t, items)
+	first, _ := items[0].(map[string]any)
+	assert.Equal(t, "", first["canonical_model_id"], "未确认的映射不得对外给出标准模型 ID")
+	assert.Equal(t, "", first["model_description"])
+
+	// 确认映射后：标准 ID 与介绍出现
+	canonical := apigxmodel.CanonicalModel{APIModelID: "standard-model-1", Description: "这是标准模型的介绍", ModalityType: 1, Status: 1}
+	require.NoError(t, env.db.Create(&canonical).Error)
+	require.NoError(t, env.db.Model(&apigxmodel.ModelAlias{}).
+		Where("normalized_model_id = ?", "upstream-name-x").
+		Updates(map[string]any{"relation": apigxmodel.AliasRelationConfirmed,
+			"confirmation_state": apigxmodel.AliasConfirmApproved, "target_canonical_model_id": canonical.ID}).Error)
+
+	_, body = env.do(t, http.MethodGet, "/api/plaza", owner, "")
+	items, _ = body["data"].(map[string]any)["items"].([]any)
+	first, _ = items[0].(map[string]any)
+	assert.Equal(t, "standard-model-1", first["canonical_model_id"])
+	assert.Equal(t, "这是标准模型的介绍", first["model_description"])
+}
diff --git a/apigx/model/repo_catalog.go b/apigx/model/repo_catalog.go
index e8c5974..5532b89 100644
--- a/apigx/model/repo_catalog.go
+++ b/apigx/model/repo_catalog.go
@@ -151,3 +151,76 @@ func ResolveCanonicalModel(db *gorm.DB, externalModelID string) (canonical Canon
 	}
 	return canonical, true, nil
 }
+
+// ResolveCanonicalModels 批量解析（广场一页会涉及多个模型名，逐个查库不合适）。
+//
+// 与单条版本**同一套规则**：只认已确认、命中多个时优先平台全局范围。
+// 返回值以**调用方传入的原名**为键，未命中的名字不出现在结果里 —— 调用方据此显示上游名。
+func ResolveCanonicalModels(db *gorm.DB, externalModelIDs []string) (map[string]CanonicalModel, error) {
+	out := make(map[string]CanonicalModel, len(externalModelIDs))
+	if db == nil {
+		return out, errors.New("apigxmodel: nil db")
+	}
+
+	// 原名 -> 归一化键（保留原名做返回键，避免调用方再去归一化）
+	normalizedToOriginal := make(map[string]string, len(externalModelIDs))
+	normalizedIDs := make([]string, 0, len(externalModelIDs))
+	for _, raw := range externalModelIDs {
+		normalized := NormalizeModelIDForAlias(raw)
+		if normalized == "" {
+			continue
+		}
+		if _, seen := normalizedToOriginal[normalized]; !seen {
+			normalizedToOriginal[normalized] = raw
+			normalizedIDs = append(normalizedIDs, normalized)
+		}
+	}
+	if len(normalizedIDs) == 0 {
+		return out, nil
+	}
+
+	var aliases []ModelAlias
+	if err := db.Model(&ModelAlias{}).
+		Where("normalized_model_id IN ? AND confirmation_state = ? AND target_canonical_model_id > 0 AND deleted_at IS NULL",
+			normalizedIDs, AliasConfirmApproved).
+		Order("scope_type ASC, id ASC").
+		Find(&aliases).Error; err != nil {
+		return out, err
+	}
+	if len(aliases) == 0 {
+		return out, nil
+	}
+
+	// 归一化键 -> 目标标准模型 ID（先到先得：已按 scope_type 升序，平台全局优先）
+	targetByNormalized := make(map[string]int64, len(aliases))
+	targetIDs := make([]int64, 0, len(aliases))
+	for _, alias := range aliases {
+		if _, exists := targetByNormalized[alias.NormalizedModelID]; exists {
+			continue
+		}
+		targetByNormalized[alias.NormalizedModelID] = alias.TargetCanonicalModelID
+		targetIDs = append(targetIDs, alias.TargetCanonicalModelID)
+	}
+
+	var models []CanonicalModel
+	if err := db.Model(&CanonicalModel{}).Where("id IN ?", targetIDs).Find(&models).Error; err != nil {
+		return out, err
+	}
+	byID := make(map[int64]CanonicalModel, len(models))
+	for _, model := range models {
+		byID[model.ID] = model
+	}
+
+	for normalized, original := range normalizedToOriginal {
+		targetID, hit := targetByNormalized[normalized]
+		if !hit {
+			continue
+		}
+		model, found := byID[targetID]
+		if !found {
+			continue
+		}
+		out[original] = model
+	}
+	return out, nil
+}
