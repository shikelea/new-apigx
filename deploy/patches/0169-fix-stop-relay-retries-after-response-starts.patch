@@ -171,6 +206,7 @@ func setupRelayMultiKeyDatabase(t *testing.T) *gorm.DB {
 	constant.ErrorLogEnabled = false
 	common.LogConsumeEnabled = false
 	constant.CountToken = false
+	constant.StreamingTimeout = 30
