diff --git a/service/relay_error.go b/service/relay_error.go
index 44c2c5d..716253f 100644
--- a/service/relay_error.go
+++ b/service/relay_error.go
@@ -22,6 +22,13 @@ func ShouldRetryRelayError(c *gin.Context, openaiErr *types.NewAPIError, retryTi
 	if openaiErr == nil {
 		return false
 	}
+	// Once any part of an HTTP response has reached the client, retrying would
+	// append another upstream response to the same body. This is especially
+	// dangerous for SSE, where an adaptor can fail after earlier events were
+	// flushed successfully.
+	if relayResponseStarted(c) {
+		return false
+	}
 	if ShouldSkipRetryAfterChannelAffinityFailure(c) {
 		return false
 	}
@@ -59,6 +66,9 @@ func ShouldFailoverMultiKeyRelayError(c *gin.Context, openaiErr *types.NewAPIErr
 	if openaiErr == nil {
 		return false
 	}
+	if relayResponseStarted(c) {
+		return false
+	}
 	if c != nil && c.Request != nil && c.Request.Context().Err() != nil {
 		return false
 	}
@@ -87,6 +97,10 @@ func ShouldFailoverMultiKeyRelayError(c *gin.Context, openaiErr *types.NewAPIErr
 	return operation_setting.ShouldRetryByStatusCode(code)
 }
 
+func relayResponseStarted(c *gin.Context) bool {
+	return c != nil && c.Writer != nil && c.Writer.Written()
+}
+
 func ProcessChannelError(c *gin.Context, channelError types.ChannelError, err *types.NewAPIError, relayInfo *relaycommon.RelayInfo) {
 	if err == nil {
 		return
diff --git a/service/relay_error_test.go b/service/relay_error_test.go
index 3fe79fc..ba8b615 100644
--- a/service/relay_error_test.go
+++ b/service/relay_error_test.go
@@ -79,6 +79,22 @@ func TestShouldFailoverMultiKeyRelayErrorIgnoresOnlyRetryBudget(t *testing.T) {
 	assert.False(t, ShouldFailoverMultiKeyRelayError(c, rateLimited))
 }
 
+func TestRelayRetryStopsAfterResponseStarted(t *testing.T) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+
+	rateLimited := types.NewErrorWithStatusCode(errors.New("rate limited"), types.ErrorCodeBadResponseStatusCode, http.StatusTooManyRequests)
+	require.True(t, ShouldRetryRelayError(c, rateLimited, 1))
+	require.True(t, ShouldFailoverMultiKeyRelayError(c, rateLimited))
+
+	_, err := c.Writer.Write([]byte("data: partial\n\n"))
+	require.NoError(t, err)
+	require.True(t, c.Writer.Written())
+	assert.False(t, ShouldRetryRelayError(c, rateLimited, 1))
+	assert.False(t, ShouldFailoverMultiKeyRelayError(c, rateLimited))
+}
+
