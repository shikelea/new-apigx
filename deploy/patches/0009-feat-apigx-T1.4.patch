+++ b/apigx/route/route.go
@@ -0,0 +1,22 @@
+// Package apigxroute 是 APIGX 接口的路由注册入口。
+//
+// 上游 `router/` 里只需要一处几行的接线；所有具体路由都集中在这里，
+// 便于「以新增文件为主、少改上游」的维护策略（docs/architecture/baseline.md §3 E1）。
+package apigxroute
+
+import (
+	apigxapi "github.com/QuantumNous/new-api/apigx/api"
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/gin-gonic/gin"
+)
+
+// BasePath 是 APIGX 接口的挂载前缀（最终路径形如 /api/apigx/share-groups）。
+const BasePath = "/apigx"
+
+// Register 把 APIGX 的分享者接口挂到传入的路由组上。
+//
+// 调用方负责挂认证中间件（UserAuth）；本函数只负责路由与处理器。
+// 数据库句柄由 `apigxmodel.Migrate` 在启动时捕获（见其注释），因此这里不需要额外参数。
+func Register(apiRouter *gin.RouterGroup) {
+	apigxapi.Register(apiRouter.Group(BasePath), apigxmodel.DefaultDB())
+}
diff --git a/apigx/secretbox/secretbox.go b/apigx/secretbox/secretbox.go
new file mode 100644
index 0000000..8fa8063
--- /dev/null
+++ b/apigx/secretbox/secretbox.go
@@ -0,0 +1,158 @@
+// Package secretbox 提供「上游凭据的静态加密封装」。
+//
+// 计划书 §10.3 对两类凭据的要求不同，必须分清：
+//   - **平台 API Key**（使用者凭证）：按用户决定跟随底座现状（`tokens.key` 明文 + 等值查找），
+//     见 docs/architecture/tech-debt.md 的 TD-07；本包不涉及。
+//   - **上游 Key**（分享者的供应商凭据）：平台**必须**加密存储，主密钥与数据库分离，
+//     界面不回显完整凭据，日志/错误/监控都不得携带。
+//
+// 设计要点：
+//   - AES-256-GCM：同时保证机密性与完整性（密文被篡改会解密失败，而不是返回垃圾明文）。
+//   - 信封格式 `enc:v1:<base64(nonce)>:<base64(ciphertext)>`：带版本号，便于将来换算法而不破坏旧数据。
+//   - 主密钥来自环境变量 `APIGX_SECRET_KEY`（64 位十六进制 = 32 字节），**不入库**。
+//   - 缺少或非法的主密钥时**失败关闭**：拒绝写入，绝不退化成明文存储。
+package secretbox
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"sync"
+)
+
+const (
+	// EnvelopePrefix 是信封前缀，形如 `enc:v1:...`。
+	EnvelopePrefix = "enc:v1:"
+	// KeyEnvVar 是主密钥的环境变量名。
+	KeyEnvVar = "APIGX_SECRET_KEY"
+	// KeyBytes 是 AES-256 要求的密钥长度。
+	KeyBytes = 32
+)
+
+var (
+	// ErrKeyNotConfigured 表示主密钥未配置——写入凭据必须失败，不能退化为明文。
+	ErrKeyNotConfigured = errors.New("secretbox: master key not configured (set " + KeyEnvVar + ")")
+	// ErrInvalidEnvelope 表示信封格式非法或版本不受支持。
+	ErrInvalidEnvelope = errors.New("secretbox: invalid envelope")
+	// ErrDecrypt 表示解密失败（密钥不对或密文被篡改）。
+	ErrDecrypt = errors.New("secretbox: decryption failed")
+)
+
+var (
+	keyOnce sync.Once
+	keyVal  []byte
+	keyErr  error
+)
+
+// loadKey 从环境变量读取主密钥（进程内只读一次）。
+func loadKey() ([]byte, error) {
+	keyOnce.Do(func() {
+		raw := strings.TrimSpace(os.Getenv(KeyEnvVar))
+		if raw == "" {
+			keyErr = ErrKeyNotConfigured
+			return
+		}
+		decoded, err := hex.DecodeString(raw)
+		if err != nil {
+			keyErr = fmt.Errorf("secretbox: %s must be hex-encoded: %w", KeyEnvVar, err)
+			return
+		}
+		if len(decoded) != KeyBytes {
+			keyErr = fmt.Errorf("secretbox: %s must decode to %d bytes (got %d)", KeyEnvVar, KeyBytes, len(decoded))
+			return
+		}
+		keyVal = decoded
+	})
+	return keyVal, keyErr
+}
+
+// ResetKeyCacheForTest 清空密钥缓存，供测试切换主密钥使用。**不得在请求路径上调用。**
+func ResetKeyCacheForTest() {
+	keyOnce = sync.Once{}
+	keyVal = nil
+	keyErr = nil
+}
+
+func newGCM(key []byte) (cipher.AEAD, error) {
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	return cipher.NewGCM(block)
+}
+
+// Encrypt 把明文封装成信封字符串。
+//
+// 返回值形如 `enc:v1:<nonce-b64>:<ciphertext-b64>`，可直接存进 `secret_ref`。
+// 主密钥缺失时返回 ErrKeyNotConfigured（**失败关闭**）。
+func Encrypt(plaintext string) (string, error) {
+	if plaintext == "" {
+		return "", fmt.Errorf("%w: refusing to encrypt empty secret", ErrInvalidEnvelope)
+	}
+	key, err := loadKey()
+	if err != nil {
+		return "", err
+	}
+	gcm, err := newGCM(key)
+	if err != nil {
+		return "", err
+	}
+	nonce := make([]byte, gcm.NonceSize())
+	if _, err := rand.Read(nonce); err != nil {
+		return "", fmt.Errorf("secretbox: nonce: %w", err)
+	}
+	sealed := gcm.Seal(nil, nonce, []byte(plaintext), nil)
+	return EnvelopePrefix +
+		base64.RawURLEncoding.EncodeToString(nonce) + ":" +
+		base64.RawURLEncoding.EncodeToString(sealed), nil
+}
+
+// Decrypt 解出信封里的明文。密钥不对或密文被改动都会返回 ErrDecrypt。
+func Decrypt(envelope string) (string, error) {
+	if !strings.HasPrefix(envelope, EnvelopePrefix) {
+		return "", ErrInvalidEnvelope
+	}
+	parts := strings.Split(strings.TrimPrefix(envelope, EnvelopePrefix), ":")
+	if len(parts) != 2 {
+		return "", ErrInvalidEnvelope
+	}
+	nonce, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return "", ErrInvalidEnvelope
+	}
+	sealed, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return "", ErrInvalidEnvelope
+	}
+	key, err := loadKey()
+	if err != nil {
+		return "", err
+	}
+	gcm, err := newGCM(key)
+	if err != nil {
+		return "", err
+	}
+	if len(nonce) != gcm.NonceSize() {
+		return "", ErrInvalidEnvelope
+	}
+	plain, err := gcm.Open(nil, nonce, sealed, nil)
+	if err != nil {
+		return "", ErrDecrypt
+	}
+	return string(plain), nil
+}
+
+// IsEnvelope 报告某个引用是否为本包生成的信封（用于区分「已加密」与「外部引用」）。
+func IsEnvelope(ref string) bool { return strings.HasPrefix(ref, EnvelopePrefix) }
+
+// IsConfigured 报告主密钥是否可用（供启动自检使用）。
+func IsConfigured() bool {
+	_, err := loadKey()
+	return err == nil
+}
diff --git a/apigx/secretbox/secretbox_test.go b/apigx/secretbox/secretbox_test.go
new file mode 100644
index 0000000..c515a1a
--- /dev/null
+++ b/apigx/secretbox/secretbox_test.go
@@ -0,0 +1,167 @@
+package secretbox
+
+import (
+	"encoding/base64"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const testKeyHex = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"
+
+func withKey(t *testing.T, hexKey string) {
+	t.Helper()
+	previous, had := os.LookupEnv(KeyEnvVar)
+	require.NoError(t, os.Setenv(KeyEnvVar, hexKey))
+	ResetKeyCacheForTest()
+	t.Cleanup(func() {
+		if had {
+			_ = os.Setenv(KeyEnvVar, previous)
+		} else {
+			_ = os.Unsetenv(KeyEnvVar)
+		}
+		ResetKeyCacheForTest()
+	})
+}
+
+func TestEncryptDecryptRoundTrip(t *testing.T) {
+	withKey(t, testKeyHex)
+
+	plaintext := "sk-upstream-SECRET-abcdefghijklmnop"
+	envelope, err := Encrypt(plaintext)
+	require.NoError(t, err)
+
+	assert.True(t, strings.HasPrefix(envelope, EnvelopePrefix))
+	assert.True(t, IsEnvelope(envelope))
+
+	// 密文里绝不能出现明文片段：这是「不落明文」的最直接证据
+	assert.NotContains(t, envelope, plaintext)
+	assert.NotContains(t, envelope, "SECRET")
+
+	got, err := Decrypt(envelope)
+	require.NoError(t, err)
+	assert.Equal(t, plaintext, got)
+}
+
+// 同一个明文两次加密必须得到**不同的**信封（随机 nonce）：否则密文可被用来判断「两个分享者是否用了同一把 Key」。
+func TestEncryptIsNonDeterministic(t *testing.T) {
+	withKey(t, testKeyHex)
+
+	a, err := Encrypt("same-secret")
+	require.NoError(t, err)
+	b, err := Encrypt("same-secret")
+	require.NoError(t, err)
+
+	assert.NotEqual(t, a, b, "相同明文不得产生相同密文")
+	assert.Len(t, strings.Split(strings.TrimPrefix(a, EnvelopePrefix), ":"), 2)
+
+	gotA, errA := Decrypt(a)
+	gotB, errB := Decrypt(b)
+	require.NoError(t, errA)
+	require.NoError(t, errB)
+	assert.Equal(t, gotA, gotB)
+}
+
+// GCM 保证完整性：密文被改动必须解密失败，而不是返回垃圾明文。
+//
+// 篡改方式必须**确定性地改变解码后的字节**：早先的写法是替换 base64 的最后一个字符，
+// 但 last-char 的部分比特在 RawURL 编码里可能被忽略，于是「篡改」有时根本没发生，
+// 测试变成偶发通过/失败。改成翻转解码后的第一个字节，再重新编码。
+func TestDecryptRejectsTamperedCiphertext(t *testing.T) {
+	withKey(t, testKeyHex)
+
+	envelope, err := Encrypt("sk-tamper-me")
+	require.NoError(t, err)
+
+	parts := strings.Split(strings.TrimPrefix(envelope, EnvelopePrefix), ":")
+	require.Len(t, parts, 2)
+
+	sealed, err := base64.RawURLEncoding.DecodeString(parts[1])
+	require.NoError(t, err)
+	require.NotEmpty(t, sealed)
+
+	sealed[0] ^= 0xFF // 确定性翻转一个字节
+	tampered := EnvelopePrefix + parts[0] + ":" + base64.RawURLEncoding.EncodeToString(sealed)
+
+	_, err = Decrypt(tampered)
+	assert.ErrorIs(t, err, ErrDecrypt, "密文被改动必须完整性校验失败")
+
+	// 篡改 nonce 同样必须失败
+	nonce, err := base64.RawURLEncoding.DecodeString(parts[0])
+	require.NoError(t, err)
+	nonce[0] ^= 0xFF
+	tamperedNonce := EnvelopePrefix + base64.RawURLEncoding.EncodeToString(nonce) + ":" + parts[1]
+	_, err = Decrypt(tamperedNonce)
+	assert.ErrorIs(t, err, ErrDecrypt, "nonce 被改动必须失败")
+
+	// 原信封仍然可解（证明上面两步确实只动了副本）
+	plain, err := Decrypt(envelope)
+	require.NoError(t, err)
+	assert.Equal(t, "sk-tamper-me", plain)
+}
+
+// 换一把主密钥后旧密文不可解——这正是「主密钥与数据库分离」的意义所在。
+func TestDecryptFailsWithWrongKey(t *testing.T) {
+	withKey(t, testKeyHex)
+	envelope, err := Encrypt("sk-under-key-1")
+	require.NoError(t, err)
+
+	otherKey := strings.Repeat("ab", KeyBytes)
+	withKey(t, otherKey)
+	_, err = Decrypt(envelope)
+	assert.ErrorIs(t, err, ErrDecrypt)
+}
+
+// 主密钥未配置时必须**失败关闭**：拒绝加密，而不是退化成明文存储。
+func TestEncryptFailsClosedWithoutKey(t *testing.T) {
+	withKey(t, "")
+
+	assert.False(t, IsConfigured())
+
+	_, err := Encrypt("sk-must-not-be-plaintext")
+	assert.ErrorIs(t, err, ErrKeyNotConfigured, "缺主密钥时必须拒绝写入，不能明文落库")
+
+	_, err = Decrypt(EnvelopePrefix + "AAAA:BBBB")
+	assert.ErrorIs(t, err, ErrKeyNotConfigured)
+}
+
+func TestKeyValidation(t *testing.T) {
+	for _, tt := range []struct {
+		name string
+		key  string
+	}{
+		{"非十六进制", "not-hex-at-all"},
+		{"长度不足", "00112233"},
+		{"长度过长", testKeyHex + "aa"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			withKey(t, tt.key)
+			assert.False(t, IsConfigured())
+			_, err := Encrypt("x")
+			require.Error(t, err)
+			assert.NotErrorIs(t, err, ErrDecrypt)
+		})
+	}
+}
+
+func TestEnvelopeFormatValidation(t *testing.T) {
+	withKey(t, testKeyHex)
+
+	for _, bad := range []string{
+		"",
+		"sk-plaintext-not-an-envelope",
+		"enc:v2:AAAA:BBBB",     // 版本不受支持
+		"enc:v1:only-one-part", // 缺少密文段
+		"enc:v1:AAAA:BBBB:CC",  // 段数过多
+		"enc:v1:!!!:###",       // base64 非法
+	} {
+		_, err := Decrypt(bad)
+		assert.ErrorIs(t, err, ErrInvalidEnvelope, "输入：%q", bad)
+	}
+
+	_, err := Encrypt("")
+	assert.ErrorIs(t, err, ErrInvalidEnvelope, "空明文应被拒绝")
+}
