+// 「我的用量」的对外数据结构（字段与后端 `GET /api/apigx/usage` 一致）。
+
+/** 本次请求的来源：分享渠道或平台自有。 */
+export interface UsageSource {
+  kind: 'share' | 'platform'
+  channel_public_id?: string
+  owner_user_id?: number
+}
+
+/** 一条用量记录（一次请求）。 */
+export interface UsageEntry {
+  created_at: number
+  model: string
+  prompt_tokens: number
+  completion_tokens: number
+  total_tokens: number
+  /** 底座额度（参考价） */
+  quota: number
+  /** 换算后的成本（微美元） */
+  cost_micro_usd: number
+  elapsed_seconds: number
+  is_stream: boolean
+  request_id: string
+  /** **路由结果**：这次实际用了哪条来源 */
+  source?: UsageSource
+}
+
+export interface UsageListResponse {
+  success: boolean
+  data?: {
+    items: UsageEntry[]
+    total: number
+    page: number
+    page_size: number
+  }
+}
+
+export interface GetUsageParams {
+  page?: number
+  page_size?: number
+  model?: string
+  start?: number
+  end?: number
+}
