+  PRICE_SCOPE_OPTIONS,
+} from '../lib/price'
 
 describe('每百万 token 价格解析', () => {
   it('合法数字被接受', () => {
@@ -57,4 +66,16 @@ describe('价格作用域选项', () => {
   it('与后端的三种作用域一一对应', () => {
     expect(PRICE_SCOPE_OPTIONS.map((option) => option.value)).toEqual([0, 1, 2])
   })
+})
+describe('供给审核规则', () => {
+  it('只有"已提交"的供给可被审核', () => {
+    expect(isOfferingReviewable(OFFERING_STATUS_SUBMITTED)).toBe(true)
