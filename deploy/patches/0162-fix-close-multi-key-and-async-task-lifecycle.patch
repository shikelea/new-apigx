+
+var taskCancelAdaptorProvider = func(task *model.Task) relaychannel.TaskAdaptor {
+	if task == nil {
+		return nil
+	}
+	return relay.GetTaskAdaptor(task.Platform)
+}
+
+var taskCancelCredentialResolver = relayhook.ResolveAsyncTaskCredential
+
+// CancelTask cancels only through an adaptor that explicitly implements
+// TaskCancellationAdaptor. Unsupported channels return a stable capability
+// error; they are never marked canceled locally.
+func CancelTask(c *gin.Context) {
+	taskID := strings.TrimSpace(c.Param("task_id"))
+	if taskID == "" {
+		taskID = strings.TrimSpace(c.Param("video_id"))
+	}
+	if taskID == "" {
+		taskID = strings.TrimSpace(c.Param("key"))
+	}
+	task, exists, err := model.GetByTaskId(c.GetInt("id"), taskID)
+	if err != nil {
+		writeTaskCancelError(c, http.StatusInternalServerError, "task_cancel_query_failed", "Failed to query task")
+		return
+	}
+	if !exists || task == nil {
+		writeTaskCancelError(c, http.StatusNotFound, "task_not_found", "Task not found")
+		return
+	}
+	if task.Status == model.TaskStatusSuccess || task.Status == model.TaskStatusFailure {
+		writeTaskCancelError(c, http.StatusConflict, "task_already_terminal", "Task is already terminal")
+		return
+	}
+	if relayhook.CheckSourceAllowed(c, task.ChannelId, taskSourceModelName(task)) != nil {
+		writeTaskCancelError(c, http.StatusServiceUnavailable, "no_available_source", "No available source for the requested model")
+		return
+	}
+	adaptor := taskCancelAdaptorProvider(task)
+	canceler, supported := adaptor.(relaychannel.TaskCancellationAdaptor)
+	if !supported {
+		writeTaskCancelError(c, http.StatusNotImplemented, "task_cancellation_not_supported", "This channel does not support task cancellation")
+		return
+	}
+	channel, err := model.CacheGetChannel(task.ChannelId)
+	if err != nil {
+		writeTaskCancelError(c, http.StatusServiceUnavailable, "task_channel_unavailable", "Task channel is unavailable")
+		return
+	}
+	key := channel.Key
+	if task.PrivateData.Key != "" {
+		key = task.PrivateData.Key
+	}
+	credential, managed, err := taskCancelCredentialResolver(task.ID, task.ChannelId)
+	if err != nil {
+		writeTaskCancelError(c, http.StatusServiceUnavailable, "task_credential_unavailable", "Task credential snapshot is unavailable")
+		return
+	}
+	if managed {
+		key = credential.Secret
+	}
+	baseURL := channel.GetBaseURL()
+	if baseURL == "" {
+		baseURL = constant.GetChannelBaseURL(channel.Type)
+	}
+	adaptor.Init(&relaycommon.RelayInfo{ChannelMeta: &relaycommon.ChannelMeta{
+		ChannelType: channel.Type, ChannelId: channel.Id, ChannelBaseUrl: baseURL,
+		ApiKey: key, ChannelSetting: channel.GetSetting(),
+	}})
+	confirmed, err := canceler.CancelTask(c.Request.Context(), baseURL, key, task, channel.GetSetting().Proxy)
+	if err != nil {
+		writeTaskCancelError(c, http.StatusBadGateway, "task_cancel_upstream_failed", "Upstream cancellation failed")
+		return
+	}
+	if !confirmed {
+		c.JSON(http.StatusAccepted, gin.H{"id": task.TaskID, "status": "cancel_pending"})
+		return
+	}
+	won, err := service.FinalizeCanceledTask(c.Request.Context(), adaptor, task)
+	if err != nil {
+		writeTaskCancelError(c, http.StatusInternalServerError, "task_cancel_finalize_failed", "Failed to finalize cancellation")
+		return
+	}
+	if !won {
+		writeTaskCancelError(c, http.StatusConflict, "task_already_terminal", "Task is already terminal")
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"id": task.TaskID, "status": "canceled"})
+}
+
+func writeTaskCancelError(c *gin.Context, status int, code, message string) {
+	if c == nil {
+		return
+	}
+	if message == "" {
+		message = http.StatusText(status)
+	}
+	c.JSON(status, gin.H{"error": gin.H{"message": message, "type": code, "code": code}})
+}
diff --git a/controller/task_cancel_test.go b/controller/task_cancel_test.go
new file mode 100644
index 0000000..2f48d81
--- /dev/null
+++ b/controller/task_cancel_test.go
@@ -0,0 +1,131 @@
+package controller
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/QuantumNous/new-api/apigx/relayhook"
+	"github.com/QuantumNous/new-api/model"
+	relaychannel "github.com/QuantumNous/new-api/relay/channel"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type cancellationTestAdaptor struct {
+	relaychannel.TaskAdaptor
+	confirmed bool
+	err       error
+	key       string
+}
+
+func (a *cancellationTestAdaptor) Init(*relaycommon.RelayInfo) {}
+func (a *cancellationTestAdaptor) AdjustBillingOnComplete(*model.Task, *relaycommon.TaskInfo) int {
+	return 0
+}
+func (a *cancellationTestAdaptor) CancelTask(_ context.Context, _ string, key string, _ *model.Task, _ string) (bool, error) {
+	a.key = key
+	return a.confirmed, a.err
+}
+
+func newTaskCancelContext(task *model.Task) (*gin.Context, *httptest.ResponseRecorder) {
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Set("id", task.UserId)
+	c.Params = gin.Params{{Key: "key", Value: task.TaskID}}
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/tasks/"+task.TaskID+"/cancel", nil)
+	return c, recorder
+}
+
+func setupCancelableTask(t *testing.T) *model.Task {
+	t.Helper()
+	task := setupGenericTaskTest(t)
+	task.Status = model.TaskStatusInProgress
+	task.Progress = "50%"
+	task.FinishTime = 0
+	task.PrivateData.Key = "historical-base-key"
+	require.NoError(t, model.DB.Save(task).Error)
+	previousGuard := relayhook.IsSourceGuardEnabled()
+	relayhook.SetSourceGuardEnabled(false)
+	t.Cleanup(func() { relayhook.SetSourceGuardEnabled(previousGuard) })
+	previousResolver := taskCancelCredentialResolver
+	taskCancelCredentialResolver = func(int64, ...int) (*relayhook.AsyncTaskCredential, bool, error) {
+		return nil, false, nil
+	}
+	t.Cleanup(func() { taskCancelCredentialResolver = previousResolver })
+	return task
+}
+
+func TestCancelTaskRejectsUnsupportedAdaptorWithoutChangingTask(t *testing.T) {
+	task := setupCancelableTask(t)
+	previous := taskCancelAdaptorProvider
+	taskCancelAdaptorProvider = func(*model.Task) relaychannel.TaskAdaptor { return nil }
+	t.Cleanup(func() { taskCancelAdaptorProvider = previous })
+	c, recorder := newTaskCancelContext(task)
+
+	CancelTask(c)
+
+	assert.Equal(t, http.StatusNotImplemented, recorder.Code)
+	assert.Contains(t, recorder.Body.String(), "task_cancellation_not_supported")
+	var persisted model.Task
+	require.NoError(t, model.DB.First(&persisted, task.ID).Error)
+	assert.Equal(t, model.TaskStatus(model.TaskStatusInProgress), persisted.Status)
+}
+
+func TestCancelTaskWaitsForUpstreamConfirmation(t *testing.T) {
+	task := setupCancelableTask(t)
+	adaptor := &cancellationTestAdaptor{confirmed: false}
+	previous := taskCancelAdaptorProvider
+	taskCancelAdaptorProvider = func(*model.Task) relaychannel.TaskAdaptor { return adaptor }
+	t.Cleanup(func() { taskCancelAdaptorProvider = previous })
+	c, recorder := newTaskCancelContext(task)
+
+	CancelTask(c)
+
+	assert.Equal(t, http.StatusAccepted, recorder.Code)
+	assert.Contains(t, recorder.Body.String(), "cancel_pending")
+	var persisted model.Task
+	require.NoError(t, model.DB.First(&persisted, task.ID).Error)
+	assert.Equal(t, model.TaskStatus(model.TaskStatusInProgress), persisted.Status)
+}
+
+func TestCancelTaskDoesNotExposeUpstreamError(t *testing.T) {
+	task := setupCancelableTask(t)
+	adaptor := &cancellationTestAdaptor{err: errors.New("provider body contains sk-upstream-secret")}
+	previous := taskCancelAdaptorProvider
+	taskCancelAdaptorProvider = func(*model.Task) relaychannel.TaskAdaptor { return adaptor }
+	t.Cleanup(func() { taskCancelAdaptorProvider = previous })
+	c, recorder := newTaskCancelContext(task)
+
+	CancelTask(c)
+
+	assert.Equal(t, http.StatusBadGateway, recorder.Code)
+	assert.Contains(t, recorder.Body.String(), "task_cancel_upstream_failed")
+	assert.NotContains(t, recorder.Body.String(), "sk-upstream-secret")
+	var persisted model.Task
+	require.NoError(t, model.DB.First(&persisted, task.ID).Error)
+	assert.Equal(t, model.TaskStatus(model.TaskStatusInProgress), persisted.Status)
+}
+
+func TestCancelTaskFinalizesOnlyAfterUpstreamConfirmation(t *testing.T) {
+	task := setupCancelableTask(t)
+	adaptor := &cancellationTestAdaptor{confirmed: true}
+	previous := taskCancelAdaptorProvider
+	taskCancelAdaptorProvider = func(*model.Task) relaychannel.TaskAdaptor { return adaptor }
+	t.Cleanup(func() { taskCancelAdaptorProvider = previous })
+	c, recorder := newTaskCancelContext(task)
+
+	CancelTask(c)
+
+	assert.Equal(t, http.StatusOK, recorder.Code)
+	assert.Contains(t, recorder.Body.String(), `"status":"canceled"`)
+	assert.Equal(t, "historical-base-key", adaptor.key)
+	var persisted model.Task
+	require.NoError(t, model.DB.First(&persisted, task.ID).Error)
+	assert.Equal(t, model.TaskStatus(model.TaskStatusFailure), persisted.Status)
+	assert.Equal(t, "user_canceled", persisted.FailReason)
+}
diff --git a/model/channel.go b/model/channel.go
index bb192a3..e18e493 100644
--- a/model/channel.go
+++ b/model/channel.go
@@ -69,6 +69,289 @@ type ChannelInfo struct {
 	MultiKeyDisabledTime   map[int]int64         `json:"multi_key_disabled_time,omitempty"`   // key禁用时间列表，key index -> time
 	MultiKeyPollingIndex   int                   `json:"multi_key_polling_index"`             // 多Key模式下轮询的key索引
 	MultiKeyMode           constant.MultiKeyMode `json:"multi_key_mode"`
+	// MultiKeyStableIDs 与真实 Key 列表一一对齐。APIGX 用它让健康、容量和统计锚定稳定身份，
+	// 避免增删、重排或权重变化后把按位置保存的状态套到另一把 Key 上。
+	MultiKeyStableIDs []string `json:"multi_key_stable_ids,omitempty"`
+	// MultiKeyWeights 与真实 Key 列表一一对齐；权重直接参与选择，不再通过复制明文槽位表达。
+	MultiKeyWeights []int64 `json:"multi_key_weights,omitempty"`
+	// 以下三张表是带稳定身份渠道的权威运行期状态。旧索引表仍保留并镜像写入，
+	// 以兼容未提供稳定 ID 的原生 New API 渠道与既有管理接口。
+	MultiKeyStatusByStableID         map[string]int    `json:"multi_key_status_by_stable_id,omitempty"`
+	MultiKeyDisabledReasonByStableID map[string]string `json:"multi_key_disabled_reason_by_stable_id,omitempty"`
+	MultiKeyDisabledTimeByStableID   map[string]int64  `json:"multi_key_disabled_time_by_stable_id,omitempty"`
+	// 状态来源表让底座健康、容量和熔断分别持有自己的标记。MultiKeyStatusList 与
+	// MultiKeyStatusByStableID 只是给既有接口读取的合并镜像，恢复一个来源不会误删另一个来源。
+	MultiKeyStatusSources           map[int]map[string]int    `json:"multi_key_status_sources,omitempty"`
+	MultiKeyStatusSourcesByStableID map[string]map[string]int `json:"multi_key_status_sources_by_stable_id,omitempty"`
+}
+
+const maxMultiKeyWeight int64 = 16
+
+const multiKeyStatusSourceBase = "base"
+
+// MultiKeyStableIDAt 返回指定真实 Key 槽位的稳定身份。
+func (c *ChannelInfo) MultiKeyStableIDAt(index int) (string, bool) {
+	if c == nil || index < 0 || index >= len(c.MultiKeyStableIDs) {
+		return "", false
+	}
+	stableID := strings.TrimSpace(c.MultiKeyStableIDs[index])
+	return stableID, stableID != ""
+}
+
+func (c *ChannelInfo) multiKeyWeightAt(index int) int64 {
+	weight := int64(1)
+	if c != nil && index >= 0 && index < len(c.MultiKeyWeights) {
+		weight = c.MultiKeyWeights[index]
+	}
+	if weight <= 0 {
+		return 1
+	}
+	if weight > maxMultiKeyWeight {
+		return maxMultiKeyWeight
+	}
+	return weight
+}
+
+// MultiKeyStatusAt 返回真实 Key 槽位当前是否可选。带稳定 ID 时只读取稳定状态，
+// 避免增删/重排后旧索引镜像误伤另一把 Key；没有稳定元数据的原生渠道继续读取旧索引表。
+func (c *ChannelInfo) MultiKeyStatusAt(index int) int {
+	if c == nil {
+		return common.ChannelStatusEnabled
+	}
+	if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+		if sources := c.MultiKeyStatusSourcesByStableID[stableID]; len(sources) > 0 {
+			return mergedMultiKeyStatus(sources)
+		}
+		if c.MultiKeyStatusByStableID != nil {
+			if status, exists := c.MultiKeyStatusByStableID[stableID]; exists {
+				return status
+			}
+		}
+		return common.ChannelStatusEnabled
+	}
+	if sources := c.MultiKeyStatusSources[index]; len(sources) > 0 {
+		return mergedMultiKeyStatus(sources)
+	}
+	if c.MultiKeyStatusList != nil {
+		if status, exists := c.MultiKeyStatusList[index]; exists {
+			return status
+		}
+	}
+	return common.ChannelStatusEnabled
+}
+
+func multiKeyStatusMarkSource(markValue int) string {
+	return fmt.Sprintf("mark:%d", markValue)
+}
+
+func inferredMultiKeyStatusSource(status int) string {
+	if status >= 90 {
+		return multiKeyStatusMarkSource(status)
+	}
+	return multiKeyStatusSourceBase
+}
+
+// mergedMultiKeyStatus 合并同一 Key 的独立状态来源。底座自身状态优先用于兼容展示；
+// 其余标记取最大值以保证结果确定。任一非启用来源都会让该 Key 不可选。
+func mergedMultiKeyStatus(sources map[string]int) int {
+	if status, ok := sources[multiKeyStatusSourceBase]; ok && status != common.ChannelStatusEnabled {
+		return status
+	}
+	merged := common.ChannelStatusEnabled
+	for _, status := range sources {
+		if status != common.ChannelStatusEnabled && status > merged {
+			merged = status
+		}
+	}
+	return merged
+}
+
+// statusSourcesAt 返回指定真实槽位的权威来源表，并把升级前的单值状态迁入来源表。
+func (c *ChannelInfo) statusSourcesAt(index int) (map[string]int, bool) {
+	if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+		if c.MultiKeyStatusSourcesByStableID == nil {
+			c.MultiKeyStatusSourcesByStableID = make(map[string]map[string]int)
+		}
+		sources := c.MultiKeyStatusSourcesByStableID[stableID]
+		changed := false
+		if sources == nil {
+			sources = make(map[string]int)
+			c.MultiKeyStatusSourcesByStableID[stableID] = sources
+			changed = true
+		}
+		if len(sources) == 0 {
+			if status, exists := c.MultiKeyStatusByStableID[stableID]; exists && status != common.ChannelStatusEnabled {
+				sources[inferredMultiKeyStatusSource(status)] = status
+				changed = true
+			}
+		}
+		return sources, changed
+	}
+	if c.MultiKeyStatusSources == nil {
+		c.MultiKeyStatusSources = make(map[int]map[string]int)
+	}
+	sources := c.MultiKeyStatusSources[index]
+	changed := false
+	if sources == nil {
+		sources = make(map[string]int)
+		c.MultiKeyStatusSources[index] = sources
+		changed = true
+	}
+	if len(sources) == 0 {
+		if status, exists := c.MultiKeyStatusList[index]; exists && status != common.ChannelStatusEnabled {
+			sources[inferredMultiKeyStatusSource(status)] = status
+			changed = true
+		}
+	}
+	return sources, changed
+}
+
+func (c *ChannelInfo) refreshMultiKeyStatusAt(index int, sources map[string]int) {
+	status := mergedMultiKeyStatus(sources)
+	if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+		if status == common.ChannelStatusEnabled {
+			delete(c.MultiKeyStatusByStableID, stableID)
+		} else {
+			if c.MultiKeyStatusByStableID == nil {
+				c.MultiKeyStatusByStableID = make(map[string]int)
+			}
+			c.MultiKeyStatusByStableID[stableID] = status
+		}
+	}
+	if status == common.ChannelStatusEnabled {
+		delete(c.MultiKeyStatusList, index)
+	} else {
+		if c.MultiKeyStatusList == nil {
+			c.MultiKeyStatusList = make(map[int]int)
+		}
+		c.MultiKeyStatusList[index] = status
+	}
+}
+
+func (c *ChannelInfo) compactMultiKeyStatusSources(index int, sources map[string]int) {
+	if len(sources) != 0 {
+		return
+	}
+	if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+		delete(c.MultiKeyStatusSourcesByStableID, stableID)
+		if len(c.MultiKeyStatusSourcesByStableID) == 0 {
+			c.MultiKeyStatusSourcesByStableID = nil
+		}
+		return
+	}
+	delete(c.MultiKeyStatusSources, index)
+	if len(c.MultiKeyStatusSources) == 0 {
+		c.MultiKeyStatusSources = nil
+	}
+}
+
+// SetMultiKeyStatusAt 只更新底座健康来源，同时维护稳定身份状态和兼容索引镜像。
+func (c *ChannelInfo) SetMultiKeyStatusAt(index, status int, reason string, at int64) {
+	if c == nil || index < 0 {
+		return
+	}
+	sources, _ := c.statusSourcesAt(index)
+	if status == common.ChannelStatusEnabled {
+		delete(sources, multiKeyStatusSourceBase)
+		delete(c.MultiKeyDisabledReason, index)
+		delete(c.MultiKeyDisabledTime, index)
+		if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+			delete(c.MultiKeyDisabledReasonByStableID, stableID)
+			delete(c.MultiKeyDisabledTimeByStableID, stableID)
+		}
+		c.refreshMultiKeyStatusAt(index, sources)
+		c.compactMultiKeyStatusSources(index, sources)
+		return
+	}
+	sources[multiKeyStatusSourceBase] = status
+	if c.MultiKeyDisabledReason == nil {
+		c.MultiKeyDisabledReason = make(map[int]string)
+	}
+	if c.MultiKeyDisabledTime == nil {
+		c.MultiKeyDisabledTime = make(map[int]int64)
+	}
+	c.MultiKeyDisabledReason[index] = reason
+	c.MultiKeyDisabledTime[index] = at
+	if stableID, ok := c.MultiKeyStableIDAt(index); ok {
+		if c.MultiKeyDisabledReasonByStableID == nil {
+			c.MultiKeyDisabledReasonByStableID = make(map[string]string)
+		}
+		if c.MultiKeyDisabledTimeByStableID == nil {
+			c.MultiKeyDisabledTimeByStableID = make(map[string]int64)
+		}
+		c.MultiKeyDisabledReasonByStableID[stableID] = reason
+		c.MultiKeyDisabledTimeByStableID[stableID] = at
+	}
+	c.refreshMultiKeyStatusAt(index, sources)
+}
+
+// ReplaceMultiKeyStatusMarks 原子替换某一来源写入的状态标记，保留其他来源的状态。
+// 稳定 ID 表是权威数据，索引表只作为旧接口可见的镜像。
+func (c *ChannelInfo) ReplaceMultiKeyStatusMarks(markValue int, indexes []int) bool {
+	if c == nil {
+		return false
+	}
+	targets := make(map[int]struct{}, len(indexes))
+	for _, index := range indexes {
+		if index >= 0 && index < c.MultiKeySize {
+			targets[index] = struct{}{}
+		}
+	}
+	source := multiKeyStatusMarkSource(markValue)
+	changed := false
+	for index := 0; index < c.MultiKeySize; index++ {
+		sources, migrated := c.statusSourcesAt(index)
+		changed = changed || migrated
+		_, wanted := targets[index]
+		if wanted {
+			if current, exists := sources[source]; !exists || current != markValue {
+				sources[source] = markValue
+				changed = true
+			}
+		} else if _, exists := sources[source]; exists {
+			delete(sources, source)
+			changed = true
+		}
+		c.refreshMultiKeyStatusAt(index, sources)
+		c.compactMultiKeyStatusSources(index, sources)
+	}
+	if len(c.MultiKeyStatusList) == 0 {
+		c.MultiKeyStatusList = nil
+	}
+	if len(c.MultiKeyStatusByStableID) == 0 {
+		c.MultiKeyStatusByStableID = nil
+	}
+	return changed
+}
+
+// HasMultiKeyStatusMark 报告任一独立来源是否仍持有指定标记。
+func (c *ChannelInfo) HasMultiKeyStatusMark(markValue int) bool {
+	if c == nil {
+		return false
+	}
+	source := multiKeyStatusMarkSource(markValue)
+	for _, sources := range c.MultiKeyStatusSourcesByStableID {
+		if sources[source] == markValue {
+			return true
+		}
+	}
+	for _, sources := range c.MultiKeyStatusSources {
+		if sources[source] == markValue {
+			return true
+		}
+	}
+	// 兼容升级前尚未拆分来源的持久化单值。
+	for _, status := range c.MultiKeyStatusByStableID {
+		if status == markValue {
+			return true
+		}
+	}
+	for _, status := range c.MultiKeyStatusList {
+		if status == markValue {
+			return true
+		}
+	}
+	return false
 }
 
