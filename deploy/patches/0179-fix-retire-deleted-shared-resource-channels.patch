+// group deletion after the group has already disappeared from discovery.
+func ListChannelsByOwnerAndGroup(db *gorm.DB, ownerUserID, shareGroupID int64, limit int) ([]Channel, error) {
+	if limit <= 0 || limit > 200 {
+		limit = 50
+	}
