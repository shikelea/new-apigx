**发现并修复一个我自己引入的危险默认值**（回归跑出来抓到的）：
  第 77 轮给 createAccessInviteRequest 加了 `InviteType int`，
  而 JSON 省略该字段时零值是 0 = **注册邀请** ⇒ 调用方**不传 invite_type 会静默拿到注册码**，
  同时既有资源邀请的列表用例直接失败（require.Len(list,1) 得到 0）。
  按底座 DTO 规范（可选标量用指针）改为 `*int`：nil ⇒ 资源邀请（向后兼容），显式 0 ⇒ 注册邀请。

**新增用例**（扩展既有 repo_access_test.go，不新开文件）TestRegistrationInviteRefundRestoresUse：
  - 注册邀请码**不得**被当作资源邀请核销（反向亦然）⇒ 锁定 §10.1“两类校验逻辑独立”
  - 已用尽 ⇒ 再核销被拒
  - **RefundRegistrationInvite 回补后：次数归 0、状态回到有效、并且真的可以再次核销** ✓

**本轮同时复跑了整体验收**（邀请准入改动后）：
  五类验收脚本：对话 5/5 · 图片 5/5 · 向量/重排/语音 16/16 · 平台侧语义 12/12 · 视频 8/8 ✓
  前端套件：144 文件 / 1740 用例全过 ✓
  Go 套件：apigx/model ✅（本次新增用例 ✓）；apigx/api 经上述修复后 ✅
检查: go build ✅ / 相关用例 ✅
---
 apigx/api/access.go             |  8 +++--
 apigx/model/repo_access_test.go | 54 +++++++++++++++++++++++++++++++++
 2 files changed, 59 insertions(+), 3 deletions(-)

diff --git a/apigx/api/access.go b/apigx/api/access.go
index e97c232..42730db 100644
--- a/apigx/api/access.go
+++ b/apigx/api/access.go
@@ -39,9 +39,11 @@ import (
 
 // createAccessInviteRequest 发放邀请（资源访问邀请，或注册邀请）。
 type createAccessInviteRequest struct {
-	// InviteType 0=注册邀请（§5「邀请准入」）/ 1=资源访问邀请（默认）。
+	// InviteType 0=注册邀请（§5「邀请准入」）/ 省略或 1=资源访问邀请。
+	// 用**指针**而不是 int：省略时必须是"资源邀请"（向后兼容），
+	// 若用零值 int，省略字段会静默变成"注册邀请"——那是危险的默认值。
 	// 两类邀请**校验逻辑独立**（§10.1），因此走同一个入口但分支处理。
-	InviteType      int   `json:"invite_type"`
+	InviteType      *int  `json:"invite_type"`
 	TargetScopeType int   `json:"target_scope_type"` // 1=分享分组 / 2=模型供给
 	TargetScopeID   int64 `json:"target_scope_id"`
 	MaxUses         int64 `json:"max_uses"`   // 0=不限次数
@@ -66,7 +68,7 @@ func (h *handler) createAccessInvite(c *gin.Context) {
 	}
 	// 注册邀请（§5）：**只由平台侧发放**，且与资源邀请的校验逻辑完全分开。
 	// 它不绑定任何资源、也不携带任何角色信息 ⇒ 不可能借邀请码提权（§10.1）。
-	if req.InviteType == apigxmodel.InviteTypeRegistration {
+	if req.InviteType != nil && *req.InviteType == apigxmodel.InviteTypeRegistration {
 		if !requirePlatformReviewer(c) {
 			return
 		}
diff --git a/apigx/model/repo_access_test.go b/apigx/model/repo_access_test.go
index 45b8151..db9c12a 100644
--- a/apigx/model/repo_access_test.go
+++ b/apigx/model/repo_access_test.go
@@ -172,3 +172,57 @@ func TestSubjectCanAccessResource(t *testing.T) {
 	require.NoError(t, err)
 	assert.False(t, ok, "授权到期后不可访问")
 }
+
+// 注册邀请（§5 邀请准入）：**补偿回补**必须真的把名额还回去，且类型不得串用（§10.1）。
+//
+// 回补的用途：注册流程里"先核销、后建用户"，建用户失败时要把名额还回去（失败不该消耗邀请码）。
+func TestRegistrationInviteRefundRestoresUse(t *testing.T) {
+	db := newRepoDB(t)
+	const adminUser int64 = 9901
+
+	token, invite, err := CreateRegistrationInvite(db, adminUser, 1, 0)
+	require.NoError(t, err)
+	require.NotEmpty(t, token)
+	assert.Equal(t, InviteTypeRegistration, invite.InviteType)
+
+	// 先当作资源邀请核销 ⇒ 必须失败（两类邀请校验逻辑独立，不能串用）
+	if _, err := RedeemAccessInvite(db, token, 9902); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("注册邀请码不得被当作资源邀请核销，实际: %v", err)
+	}
+
+	// 正常核销一次 ⇒ 用尽
+	claimed, err := RedeemRegistrationInvite(db, token, 0)
+	require.NoError(t, err)
+	require.NotNil(t, claimed)
+
+	var afterRedeem Invite
+	require.NoError(t, db.Where("id = ?", invite.ID).First(&afterRedeem).Error)
+	assert.EqualValues(t, 1, afterRedeem.UsedCount)
+	assert.Equal(t, InviteStatusExhaust, afterRedeem.Status)
+
+	// 已用尽 ⇒ 再核销必须失败
+	if _, err := RedeemRegistrationInvite(db, token, 0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("已用尽的注册邀请码不得再核销，实际: %v", err)
+	}
+
+	// 补偿回补 ⇒ 名额归还、状态回到有效、**并且真的可以再次使用**
+	require.NoError(t, RefundRegistrationInvite(db, invite.ID, 0))
+
+	var afterRefund Invite
+	require.NoError(t, db.Where("id = ?", invite.ID).First(&afterRefund).Error)
+	assert.EqualValues(t, 0, afterRefund.UsedCount, "回补后使用次数应回到 0")
+	assert.Equal(t, InviteStatusActive, afterRefund.Status, "回补后应重新可用")
+
+	again, err := RedeemRegistrationInvite(db, token, 0)
+	require.NoError(t, err, "回补之后应当可以再次核销")
+	assert.NotNil(t, again)
+
+	// 反向隔离：资源邀请码不得被当作注册邀请核销
+	group := &ShareGroup{OwnerUserID: adminUser, Name: "隔离验证组", DefaultVisibility: ShareGroupVisibilityPublic, PublishStatus: 1}
+	require.NoError(t, CreateShareGroup(db, group))
+	accessToken, _, err := CreateAccessInvite(db, adminUser, InviteTargetGroup, group.ID, 1, 0, true)
+	require.NoError(t, err)
+	if _, err := RedeemRegistrationInvite(db, accessToken, 0); !errors.Is(err, ErrNotFound) {
+		t.Fatalf("资源邀请码不得被当作注册邀请核销，实际: %v", err)
+	}
+}
