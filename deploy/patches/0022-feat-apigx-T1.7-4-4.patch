+// ---- 渠道容量策略接口 ----
+
+func TestSetChannelCapacityPolicy(t *testing.T) {
+	env := newTestEnv(t, true)
+	const owner int64 = 8201
+	baseChannelID := nextBaseChannelID()
+	require.NoError(t, env.db.Create(&basemodel.Channel{
+		Id: int(baseChannelID), Name: "底座", Key: "x", Status: common.ChannelStatusEnabled,
+	}).Error)
+	groupID := env.createGroup(t, owner, "策略组")
+	channelID := env.createChannel(t, owner, groupID, baseChannelID)
+
+	// 明确值：创建策略并挂到渠道上
+	rec, body := env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", owner,
+		`{"concurrency_mode":4,"concurrency_value":3}`)
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+	data, _ := body["data"].(map[string]any)
+	policyID := int64(data["id"].(float64))
+
+	var stored apigxmodel.CapacityPolicy
+	require.NoError(t, env.db.Where("id = ?", policyID).First(&stored).Error)
+	assert.EqualValues(t, 4, stored.MaxConcurrencyMode)
+	assert.EqualValues(t, 3, stored.MaxConcurrency)
+	assert.EqualValues(t, 1, stored.PolicyVersion)
+
+	// 再次设置：应更新同一条（不新建），版本号递增
+	rec, body = env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", owner,
+		`{"concurrency_mode":4,"concurrency_value":9}`)
+	require.Equal(t, http.StatusOK, rec.Code)
+	data, _ = body["data"].(map[string]any)
+	assert.Equal(t, float64(policyID), data["id"], "同一渠道只保留一条策略")
+
+	var count int64
+	require.NoError(t, env.db.Model(&apigxmodel.CapacityPolicy{}).Count(&count).Error)
+	assert.EqualValues(t, 1, count)
+	require.NoError(t, env.db.Where("id = ?", policyID).First(&stored).Error)
+	assert.EqualValues(t, 9, stored.MaxConcurrency)
+	assert.EqualValues(t, 2, stored.PolicyVersion)
+
+	// 四态非法组合必须被拒（明确值要求 > 0）
+	rec, _ = env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", owner,
+		`{"concurrency_mode":4,"concurrency_value":0}`)
+	assert.Equal(t, http.StatusBadRequest, rec.Code, "非法四态组合不得落库")
+	// 未配置模式但给了值，同样非法
+	rec, _ = env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", owner,
+		`{"concurrency_mode":0,"concurrency_value":5}`)
+	assert.Equal(t, http.StatusBadRequest, rec.Code)
+	// 缺 mode
+	rec, _ = env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", owner, `{}`)
+	assert.Equal(t, http.StatusBadRequest, rec.Code)
+
+	// 越权：别人的渠道一律 404
+	rec, _ = env.do(t, http.MethodPut, "/api/channels/"+strconv.FormatInt(channelID, 10)+"/capacity-policy", 8202,
+		`{"concurrency_mode":4,"concurrency_value":1}`)
+	assert.Equal(t, http.StatusNotFound, rec.Code)
+}
diff --git a/apigx/channelpool/policy_source.go b/apigx/channelpool/policy_source.go
new file mode 100644
index 0000000..d247f22
--- /dev/null
+++ b/apigx/channelpool/policy_source.go
@@ -0,0 +1,119 @@
+package channelpool
+
+import (
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+// 容量策略的读取与缓存。
+//
+// # 为什么要有缓存
+//
+// 上限要在**每个请求**上解析（热路径），而策略存在数据库里。缓存按「分享渠道」维度存
+// 已经解析好的**策略链**，TTL 取短值；策略变更（分享者改上限）最长一个 TTL 后生效——
+// 这一点必须记录：容量上限不是「改了立刻全局生效」的配置，短暂延迟是可接受的，
+// 因为它只影响准入的宽严，不会造成记账错误。
+
+const policyCacheTTL = 30 * time.Second
+
+type cachedPolicies struct {
+	// concurrency 是并发维度的策略链（最具体在最前）。
+	concurrency []capacity.Policy
+	expiresAt   time.Time
+}
+
+var (
+	policyCacheMu sync.RWMutex
+	policyCache   = map[int64]cachedPolicies{} // key = 分享渠道 ID
+)
+
+// policyFromRaw 把「模式 + 值」的原始组合转成四态策略。
+//
+// 直接透传模式：**未配置（0）绝不被解释成「不限」**，解释权归 `capacity.Resolve`。
+func policyFromRaw(mode int, value int64) capacity.Policy {
+	return capacity.Policy{Mode: mode, Value: value}
+}
+
+// loadChannelConcurrencyChain 组装该分享渠道的并发上限策略链。
+//
+// 顺序是「最具体 → 最一般」：
+//  1. 渠道自身的容量策略（`apigx_channels.capacity_policy_id` → `apigx_capacity_policies`）
+//  2. 环境变量兜底（过渡期的部署级默认，值为 0 表示未配置）
+//
+// 两者都未配置时整条链仍未表态，`capacity.Resolve` 会返回 Unset —— 调用方据此
+// **不施加约束**。这正是「未配置 ≠ 不限」在行为层的体现：它是待补的过渡状态，
+// 而不是一个被解释成无限的默认值。
+func loadChannelConcurrencyChain(db *gorm.DB, shareChannelID int64, envLimit int64) []capacity.Policy {
+	chain := make([]capacity.Policy, 0, 2)
+
+	if db != nil {
+		var shareChannel apigxmodel.Channel
+		if err := db.Where("id = ?", shareChannelID).First(&shareChannel).Error; err == nil && shareChannel.CapacityPolicyID > 0 {
+			if policy, err := apigxmodel.GetCapacityPolicy(db, shareChannel.CapacityPolicyID); err == nil {
+				mode, value := policy.Concurrency()
+				chain = append(chain, policyFromRaw(mode, value))
+			} else {
+				common.SysError("channelpool: load capacity policy failed: " + err.Error())
+			}
+		}
+	}
+
+	if envLimit > 0 {
+		chain = append(chain, capacity.Policy{Mode: capacity.LimitModeValue, Value: envLimit})
+	} else {
+		chain = append(chain, capacity.Policy{Mode: capacity.LimitModeUnset})
+	}
+	return chain
+}
+
+// ChannelConcurrencyChain 返回渠道并发维度的策略链（带缓存）。
+func ChannelConcurrencyChain(db *gorm.DB, shareChannelID int64, envLimit int64) []capacity.Policy {
+	now := time.Now()
+	policyCacheMu.RLock()
+	if cached, ok := policyCache[shareChannelID]; ok && now.Before(cached.expiresAt) {
+		policyCacheMu.RUnlock()
+		return cached.concurrency
+	}
+	policyCacheMu.RUnlock()
+
+	chain := loadChannelConcurrencyChain(db, shareChannelID, envLimit)
+
+	policyCacheMu.Lock()
+	policyCache[shareChannelID] = cachedPolicies{concurrency: chain, expiresAt: now.Add(policyCacheTTL)}
+	policyCacheMu.Unlock()
+	return chain
+}
+
+// InvalidatePolicyCache 丢弃某渠道的策略缓存（策略变更、渠道变更后调用）。
+func InvalidatePolicyCache(shareChannelID int64) {
+	policyCacheMu.Lock()
+	delete(policyCache, shareChannelID)
+	policyCacheMu.Unlock()
+}
+
+// ResetPolicyCacheForTest 清空全部策略缓存（仅测试使用）。
+func ResetPolicyCacheForTest() {
+	policyCacheMu.Lock()
+	policyCache = map[int64]cachedPolicies{}
+	policyCacheMu.Unlock()
+}
+
+// ShareChannelIDByBase 按底座渠道 ID 找出我们的分享渠道 ID。
+//
+// 返回 false 表示这不是我们的分享渠道（例如管理员自建的普通渠道），
+// 此时调用方应当只有环境变量兜底可用。
+func ShareChannelIDByBase(db *gorm.DB, baseChannelID int) (int64, bool) {
+	if db == nil || baseChannelID <= 0 {
+		return 0, false
+	}
+	var shareChannel apigxmodel.Channel
+	if err := db.Where("base_channel_id = ?", baseChannelID).First(&shareChannel).Error; err != nil {
+		return 0, false
+	}
+	return shareChannel.ID, true
+}
diff --git a/apigx/model/repo_policy.go b/apigx/model/repo_policy.go
new file mode 100644
index 0000000..42eea14
--- /dev/null
+++ b/apigx/model/repo_policy.go
@@ -0,0 +1,87 @@
+package apigxmodel
+
+import (
+	"errors"
+	"fmt"
+
+	"gorm.io/gorm"
+)
+
+// 容量策略（`apigx_capacity_policies`）的读取。
+//
+// 每个维度都是「模式 + 值」的四态组合（见 docs/stage0/schema-draft.md §3.3）：
+// 未配置 / 禁用 / 继承 / 明确不限 / 明确值。**读取层不做解释**，只把原始值交给
+// `apigx/capacity` 的四态解析器（`capacity.Resolve`），避免两处各有一套解释规则。
+
+// CapacityScope 是策略的适用范围（`ScopeType`）。
+const (
+	// CapacityScopePlatform 平台级默认。
+	CapacityScopePlatform int = 0
+	// CapacityScopeChannel 分享渠道。
+	CapacityScopeChannel int = 1
+	// CapacityScopeUpstreamKey 单把上游凭据。
+	CapacityScopeUpstreamKey int = 2
+	// CapacityScopeUpstreamAccount 上游账户池。
+	CapacityScopeUpstreamAccount int = 3
+	// CapacityScopeUser 使用者。
+	CapacityScopeUser int = 4
+)
+
+// GetCapacityPolicy 按主键读取策略；不存在返回 ErrNotFound。
+func GetCapacityPolicy(db *gorm.DB, id int64) (*CapacityPolicy, error) {
+	if db == nil || id <= 0 {
+		return nil, fmt.Errorf("%w: policy id is required", ErrInvalidArgument)
+	}
+	var policy CapacityPolicy
+	err := db.Where("id = ?", id).First(&policy).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &policy, nil
+}
+
+// FindCapacityPolicyByScope 按「所有者 + 范围」读取策略；不存在返回 ErrNotFound。
+//
+// 唯一索引是 (ScopeType, ScopeID)，因此同一范围只会有一条策略。
+func FindCapacityPolicyByScope(db *gorm.DB, ownerUserID int64, scopeType int, scopeID int64) (*CapacityPolicy, error) {
+	if db == nil || scopeID <= 0 {
+		return nil, fmt.Errorf("%w: scope id is required", ErrInvalidArgument)
+	}
+	var policy CapacityPolicy
+	err := db.Where("owner_user_id = ? AND scope_type = ? AND scope_id = ?", ownerUserID, scopeType, scopeID).
+		First(&policy).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &policy, nil
+}
+
+// Concurrency 返回「并发」维度的原始四态值（模式 + 值）。
+func (p *CapacityPolicy) Concurrency() (int, int64) {
+	if p == nil {
+		return 0, 0
+	}
+	return p.MaxConcurrencyMode, p.MaxConcurrency
+}
+
+// RPM 返回「每分钟请求数」维度的原始四态值。
+func (p *CapacityPolicy) RPM() (int, int64) {
+	if p == nil {
+		return 0, 0
+	}
+	return p.RpmMode, p.RpmLimit
+}
+
+// TPM 返回「每分钟 token 数」维度的原始四态值。
+func (p *CapacityPolicy) TPM() (int, int64) {
+	if p == nil {
+		return 0, 0
+	}
+	return p.TpmMode, p.TpmLimit
+}
diff --git a/apigx/model/repo_test.go b/apigx/model/repo_test.go
