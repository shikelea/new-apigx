+
+// FindOfferingByUpstreamModel 按「渠道 + 上游模型名」定位存活供给。
+//
+// 质量统计要按供给归档样本，而供给的身份就是这一对——用列表接口再筛会多一次全量查询。
+func FindOfferingByUpstreamModel(db *gorm.DB, channelID int64, upstreamModelID string) (int64, bool, error) {
+	if db == nil || channelID <= 0 || upstreamModelID == "" {
+		return 0, false, nil
+	}
+	var offering ModelOffering
+	err := db.Where("channel_id = ? AND upstream_model_id = ? AND alive_flag = ?",
+		channelID, upstreamModelID, AliveFlagAlive).First(&offering).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return 0, false, nil
+	}
+	if err != nil {
+		return 0, false, err
+	}
+	return offering.ID, true, nil
+}
diff --git a/apigx/qualityhook/quality.go b/apigx/qualityhook/quality.go
new file mode 100644
index 0000000..ad38895
--- /dev/null
+++ b/apigx/qualityhook/quality.go
@@ -0,0 +1,121 @@
+package qualityhook
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/channelpool"
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/QuantumNous/new-api/common"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/types"
+)
+
+// 质量样本采集（T2.4 接线）：把真实请求的**结果与耗时**写进分钟统计桶。
+//
+// # 记录什么、不记录什么
+//
+//   - 时间用 `relayInfo.StartTime` / `FirstResponseTime`（都是 `time.Time`），因此
+//     延迟与首字延迟有**真实毫秒精度**——不需要像底座日志那样退化成整秒。
+//   - 归属到**供给**：桶按供给 ID 归档，而供给就是"某个渠道的某个上游模型"。
+//     非分享渠道（没有供给）直接跳过，不制造无主统计。
+//   - 记录失败**不影响请求**：统计是旁路，任何错误只写系统日志。
+//
+// 默认关闭（`APIGX_QUALITY_STATS_ENABLED`），与其它 APIGX 开关保持一致。
+
+// ClassifyOutcome 判断一次失败属于哪一类。
+//
+// 关键区分：**平台自身的拒绝不是上游质量问题**。准入（来源不允许）、容量（429）、
+// 配额不足这些拒绝都发生在**我们这里**，把它们算成"上游失败"会误伤健康渠道——
+// 那正是"错误归因"要避免的典型错误。
+func ClassifyOutcome(err *types.NewAPIError, statusCode int) int {
+	if err == nil {
+		return apigxmodel.QualityOutcomeSuccess
+	}
+	switch err.GetErrorCode() {
+	case types.ErrorCodeChannelNoAvailableKey, types.ErrorCodeInsufficientUserQuota,
+		types.ErrorCodePreConsumeTokenQuotaFailed, types.ErrorCodeQueryDataError:
+		return apigxmodel.QualityOutcomeRejected
+	}
+	if statusCode == http.StatusTooManyRequests || statusCode == http.StatusForbidden ||
+		statusCode == http.StatusPaymentRequired {
+		return apigxmodel.QualityOutcomeRejected
+	}
+	// 超时：底座有专门的错误码 `channel:response_time_exceeded`；此外 context 的 deadline
+	// 与上游 504 也按超时归因（三者指向同一件事，不必拆成三类）。
+	if errors.Is(err, context.DeadlineExceeded) || err.GetErrorCode() == types.ErrorCodeChannelResponseTimeExceeded ||
+		statusCode == http.StatusGatewayTimeout {
+		return apigxmodel.QualityOutcomeTimeout
+	}
+	// 客户端主动断开：既不是上游问题，也不是质量问题，单独归因
+	if errors.Is(err, context.Canceled) {
+		return apigxmodel.QualityOutcomeCancel
+	}
+	return apigxmodel.QualityOutcomeUpstream
+}
+
+// Enabled 报告质量采集是否开启。
+func Enabled() bool {
+	return common.GetEnvOrDefaultBool("APIGX_QUALITY_STATS_ENABLED", false)
+}
+
+// RecordFromRelay 按一次请求的结果写入质量样本。
+//
+// `apiErr` 为 nil 表示成功。函数**不返回错误**：统计失败不应影响请求处理，
+// 但会写系统日志以便发现"统计悄悄停了"。
+func RecordFromRelay(relayInfo *relaycommon.RelayInfo, apiErr *types.NewAPIError) {
+	if !Enabled() || relayInfo == nil {
+		return
+	}
+	db := channelpool.CurrentDB()
+	if db == nil || relayInfo.ChannelId <= 0 {
+		return
+	}
+	// 只有分享渠道才有供给；平台自建渠道不参与质量统计
+	shareChannelID, ok := channelpool.ShareChannelIDByBase(db, relayInfo.ChannelId)
+	if !ok {
+		return
+	}
+	modelName := relayInfo.GetOriginModelName()
+	offeringID, found, err := apigxmodel.FindOfferingByUpstreamModel(db, shareChannelID, modelName)
+	if err != nil {
+		common.SysError("apigx quality: lookup offering failed: " + err.Error())
+		return
+	}
+	if !found {
+		// 该模型在这个渠道上没有供给（未发布/已下架）：不制造无主统计
+		return
+	}
+
+	statusCode := 0
+	if apiErr != nil {
+		statusCode = apiErr.StatusCode
+	}
+	sample := apigxmodel.QualitySample{
+		OfferingID: offeringID,
+		Outcome:    ClassifyOutcome(apiErr, statusCode),
+	}
+	// 真实毫秒精度（`StartTime` / `FirstResponseTime` 都是 time.Time）
+	if !relayInfo.StartTime.IsZero() {
+		now := time.Now()
+		if elapsed := now.Sub(relayInfo.StartTime).Milliseconds(); elapsed > 0 {
+			sample.LatencyMs = elapsed
+			if !relayInfo.FirstResponseTime.IsZero() && relayInfo.FirstResponseTime.After(relayInfo.StartTime) {
+				ttft := relayInfo.FirstResponseTime.Sub(relayInfo.StartTime).Milliseconds()
+				if ttft > 0 {
+					sample.TtftMs = ttft
+					// 生成阶段 = 总时长 - 首字延迟（近似：中间的网络往返不计入）
+					if generation := elapsed - ttft; generation > 0 {
+						sample.GenerationMs = generation
+					}
+				}
+			}
+		}
+	}
+
+	if recordErr := apigxmodel.RecordQualitySample(db, sample); recordErr != nil {
+		common.SysError("apigx quality: record sample failed: " + recordErr.Error())
+	}
+}
diff --git a/apigx/qualityhook/quality_test.go b/apigx/qualityhook/quality_test.go
new file mode 100644
index 0000000..97218a6
--- /dev/null
+++ b/apigx/qualityhook/quality_test.go
@@ -0,0 +1,60 @@
+package qualityhook
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/stretchr/testify/assert"
+)
+
+// 归因的核心要求（计划书验收：「6 小时窗口内有错误、取消和少样本 | 归因正确」）：
+// **平台自身的拒绝不能被算成上游失败**，否则会误伤健康渠道。
+func TestClassifyOutcomeSeparatesPlatformRejections(t *testing.T) {
+	capacityErr := types.NewErrorWithStatusCode(errors.New("capacity exceeded"),
+		types.ErrorCodeChannelNoAvailableKey, http.StatusTooManyRequests)
+	assert.Equal(t, apigxmodel.QualityOutcomeRejected, ClassifyOutcome(capacityErr, http.StatusTooManyRequests),
+		"容量拒绝发生在我们这里，不是上游质量问题")
+
+	sourceErr := types.NewErrorWithStatusCode(errors.New("source not allowed"),
+		types.ErrorCodeChannelNoAvailableKey, http.StatusForbidden)
+	assert.Equal(t, apigxmodel.QualityOutcomeRejected, ClassifyOutcome(sourceErr, http.StatusForbidden))
+
+	quotaErr := types.NewErrorWithStatusCode(errors.New("insufficient quota"),
+		types.ErrorCodeInsufficientUserQuota, http.StatusForbidden)
+	assert.Equal(t, apigxmodel.QualityOutcomeRejected, ClassifyOutcome(quotaErr, http.StatusForbidden))
+}
+
+// 成功、上游失败、超时、取消四类如实区分。
+func TestClassifyOutcomeBasicCases(t *testing.T) {
+	assert.Equal(t, apigxmodel.QualityOutcomeSuccess, ClassifyOutcome(nil, 0))
+
+	upstream := types.NewErrorWithStatusCode(errors.New("upstream 500"),
+		types.ErrorCodeDoRequestFailed, http.StatusInternalServerError)
+	assert.Equal(t, apigxmodel.QualityOutcomeUpstream, ClassifyOutcome(upstream, http.StatusInternalServerError))
+
+	// 504 按超时归因
+	gatewayTimeout := types.NewErrorWithStatusCode(errors.New("gateway timeout"),
+		types.ErrorCodeDoRequestFailed, http.StatusGatewayTimeout)
+	assert.Equal(t, apigxmodel.QualityOutcomeTimeout, ClassifyOutcome(gatewayTimeout, http.StatusGatewayTimeout))
+
+	// context deadline 也按超时
+	deadline := types.NewErrorWithStatusCode(context.DeadlineExceeded, types.ErrorCodeDoRequestFailed, 0)
+	assert.Equal(t, apigxmodel.QualityOutcomeTimeout, ClassifyOutcome(deadline, 0))
+
+	// 客户端取消：单独归因（既不是上游问题，也不是质量问题）
+	cancelled := types.NewErrorWithStatusCode(context.Canceled, types.ErrorCodeDoRequestFailed, 0)
+	assert.Equal(t, apigxmodel.QualityOutcomeCancel, ClassifyOutcome(cancelled, 0))
+}
+
+// 默认关闭：未显式开启时不产生任何统计写入。
+func TestQualityStatsDisabledByDefault(t *testing.T) {
+	t.Setenv("APIGX_QUALITY_STATS_ENABLED", "")
+	assert.False(t, Enabled(), "质量统计必须默认关闭（与其它 APIGX 开关一致）")
+
+	t.Setenv("APIGX_QUALITY_STATS_ENABLED", "true")
+	assert.True(t, Enabled())
+}
