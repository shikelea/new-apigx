diff --git a/web/src/features/keys/components/dialogs/apigx-scope-dialog.tsx b/web/src/features/keys/components/dialogs/apigx-scope-dialog.tsx
new file mode 100644
index 0000000..defda63
--- /dev/null
+++ b/web/src/features/keys/components/dialogs/apigx-scope-dialog.tsx
@@ -0,0 +1,152 @@
+/*
