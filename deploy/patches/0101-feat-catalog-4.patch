+// listAliasCandidates 列出别名候选（默认只看待确认的）。
+func (h *handler) listAliasCandidates(c *gin.Context) {
+	if _, valid := h.ownerID(c); !valid || !requirePlatformReviewer(c) {
+		return
+	}
+	state := 0
+	if raw := c.Query("state"); raw != "" {
+		parsed, err := strconv.Atoi(raw)
+		if err != nil || parsed < 0 || parsed > 2 {
+			fail(c, http.StatusBadRequest, "invalid_query", "state must be 0..2")
+			return
+		}
+		state = parsed
+	}
+	page, pageSize := 1, 50
+	if raw := c.Query("page"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			page = parsed
+		}
+	}
+	if raw := c.Query("page_size"); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 && parsed <= 200 {
+			pageSize = parsed
+		}
+	}
+	rows, total, err := apigxmodel.ListAliasCandidates(h.db, state, pageSize, (page-1)*pageSize)
+	if err != nil {
+		failFromRepo(c, err)
+		return
+	}
+	items := make([]gin.H, 0, len(rows))
+	for _, row := range rows {
+		items = append(items, gin.H{
+			"id": row.ID, "external_model_id": row.ExternalModelID, "normalized_model_id": row.NormalizedModelID,
+			"scope_type": row.ScopeType, "scope_id": row.ScopeID, "source": row.Source, "source_ref": row.SourceRef,
+			"confirmation_state": row.ConfirmationState, "target_canonical_model_id": row.TargetCanonicalID,
+		})
+	}
+	ok(c, gin.H{"items": items, "total": total, "page": page, "page_size": pageSize})
+}
+
+// resolveConfirmTarget 从请求里取"确认到哪个标准模型"：既支持给现成的 ID，也支持给对外标准 ID
+// （后者不存在时**顺手创建** —— 否则管理员要先绕去别处建模型，这一步就会被跳过，候选永远堆着）。
+func (h *handler) resolveConfirmTarget(c *gin.Context, apiModelID string, canonicalID int64, description string, modalityType int) (int64, bool) {
+	if canonicalID > 0 {
+		return canonicalID, true
+	}
+	if strings.TrimSpace(apiModelID) == "" {
+		fail(c, http.StatusBadRequest, "invalid_body", "api_model_id or target_canonical_model_id is required")
+		return 0, false
+	}
+	model, err := apigxmodel.EnsureCanonicalModel(h.db, apiModelID, description, modalityType)
+	if err != nil {
+		failFromRepo(c, err)
+		return 0, false
+	}
+	return model.ID, true
+}
+
+// confirmAliasCandidate 确认一个候选（平台侧）。
+func (h *handler) confirmAliasCandidate(c *gin.Context) {
+	owner, valid := h.ownerID(c)
+	if !valid || !requirePlatformReviewer(c) {
+		return
+	}
+	id, valid := paramID(c, "id")
+	if !valid {
+		return
+	}
+	var req struct {
+		APIModelID             string `json:"api_model_id"`
+		TargetCanonicalModelID int64  `json:"target_canonical_model_id"`
+		Description            string `json:"description"`
+		ModalityType           int    `json:"modality_type"`
+	}
+	if err := c.ShouldBindJSON(&req); err != nil {
+		fail(c, http.StatusBadRequest, "invalid_body", "invalid request body")
+		return
+	}
+	target, okTarget := h.resolveConfirmTarget(c, req.APIModelID, req.TargetCanonicalModelID, req.Description, req.ModalityType)
+	if !okTarget {
+		return
+	}
+	if err := apigxmodel.ConfirmAliasCandidate(h.db, id, target, owner); err != nil {
+		failFromRepo(c, err)
+		return
+	}
+	ok(c, gin.H{"id": id, "confirmation_state": apigxmodel.AliasConfirmApproved, "target_canonical_model_id": target})
+}
+
+// rejectAliasCandidate 拒绝一个候选（平台侧）。
+func (h *handler) rejectAliasCandidate(c *gin.Context) {
+	owner, valid := h.ownerID(c)
+	if !valid || !requirePlatformReviewer(c) {
+		return
+	}
+	id, valid := paramID(c, "id")
+	if !valid {
+		return
+	}
+	if err := apigxmodel.RejectAliasCandidate(h.db, id, owner); err != nil {
+		failFromRepo(c, err)
+		return
+	}
+	ok(c, gin.H{"id": id, "confirmation_state": apigxmodel.AliasConfirmRejected})
+}
+
+// bulkConfirmAliases 批量确认：把所有**归一化后同名**的待确认候选一次性指到同一个标准模型（§4）。
+func (h *handler) bulkConfirmAliases(c *gin.Context) {
+	owner, valid := h.ownerID(c)
+	if !valid || !requirePlatformReviewer(c) {
+		return
+	}
+	var req struct {
+		NormalizedModelID      string `json:"normalized_model_id"`
+		APIModelID             string `json:"api_model_id"`
+		TargetCanonicalModelID int64  `json:"target_canonical_model_id"`
+		Description            string `json:"description"`
+		ModalityType           int    `json:"modality_type"`
+	}
+	if err := c.ShouldBindJSON(&req); err != nil {
+		fail(c, http.StatusBadRequest, "invalid_body", "invalid request body")
+		return
+	}
+	if strings.TrimSpace(req.NormalizedModelID) == "" {
+		fail(c, http.StatusBadRequest, "invalid_body", "normalized_model_id is required")
+		return
+	}
+	target, okTarget := h.resolveConfirmTarget(c, req.APIModelID, req.TargetCanonicalModelID, req.Description, req.ModalityType)
+	if !okTarget {
+		return
+	}
+	affected, err := apigxmodel.BulkConfirmAliases(h.db, req.NormalizedModelID, target, owner)
+	if err != nil {
+		failFromRepo(c, err)
+		return
+	}
+	ok(c, gin.H{"confirmed": affected, "target_canonical_model_id": target})
+}
diff --git a/apigx/api/share_test.go b/apigx/api/share_test.go
index e7d2960..408f4fc 100644
--- a/apigx/api/share_test.go
+++ b/apigx/api/share_test.go
@@ -1151,3 +1151,60 @@ func TestPlazaCanonicalModelOnlyAfterConfirmation(t *testing.T) {
 	assert.Equal(t, "standard-model-1", first["canonical_model_id"])
 	assert.Equal(t, "这是标准模型的介绍", first["model_description"])
 }
+
+// 别名确认工作流：计划书 §4「批量匹配、人工覆盖」。重点是**单向推进**与"确认后才对外生效"。
+func TestAliasConfirmationWorkflow(t *testing.T) {
+	env := newTestEnv(t, true)
+	const owner int64 = 9501
+
+	// 造三条候选：两条同名（大小写/空白不同）、一条不同名
+	require.NoError(t, apigxmodel.RecordAliasCandidate(env.db, apigxmodel.AliasScopePlatform, 0, 0, "Vendor-Model-A"))
+	require.NoError(t, apigxmodel.RecordAliasCandidate(env.db, apigxmodel.AliasScopePlatform, 0, 0, "  vendor-model-a "))
+	require.NoError(t, apigxmodel.RecordAliasCandidate(env.db, apigxmodel.AliasScopePlatform, 0, 0, "vendor-model-b"))
+
+	rec, body := env.do(t, http.MethodGet, "/api/model-catalog/candidates", owner, "")
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+	items, _ := body["data"].(map[string]any)["items"].([]any)
+	// 登记了三个**名字**，但其中两个归一化后同名 => 只会有 2 条候选（幂等生效）
+	require.Len(t, items, 2, "同名候选应被归一化去重")
+	// 按**身份**取行，不按下标 —— 列表按 id 倒序，用下标会取错（我踩过）
+	var candidateA, candidateB apigxmodel.ModelAlias
+	require.NoError(t, env.db.Where("normalized_model_id = ?", "vendor-model-a").First(&candidateA).Error)
+	require.NoError(t, env.db.Where("normalized_model_id = ?", "vendor-model-b").First(&candidateB).Error)
+	id := candidateA.ID
+
+	// 确认：**顺手创建标准模型**
+	rec, body = env.do(t, http.MethodPost, "/api/model-catalog/candidates/"+strconv.FormatInt(id, 10)+"/confirm", owner,
+		`{"api_model_id":"vendor-model-a","description":"介绍A","modality_type":1}`)
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+
+	// 重复确认必须 404（单向：已经确认过的不再改动）
+	rec, _ = env.do(t, http.MethodPost, "/api/model-catalog/candidates/"+strconv.FormatInt(id, 10)+"/confirm", owner,
+		`{"api_model_id":"vendor-model-a"}`)
+	assert.Equal(t, http.StatusNotFound, rec.Code, "重复确认应被拒（单向推进）")
+
+	// 已确认的不能再被拒绝
+	rec, _ = env.do(t, http.MethodPost, "/api/model-catalog/candidates/"+strconv.FormatInt(id, 10)+"/reject", owner, "")
+	assert.Equal(t, http.StatusNotFound, rec.Code, "已确认的候选不得被拒绝")
+
+	// 另一条候选：拒绝后不能再确认
+	rec, _ = env.do(t, http.MethodPost, "/api/model-catalog/candidates/"+strconv.FormatInt(candidateB.ID, 10)+"/reject", owner, "")
+	assert.Equal(t, http.StatusOK, rec.Code)
+	rec, _ = env.do(t, http.MethodPost, "/api/model-catalog/candidates/"+strconv.FormatInt(candidateB.ID, 10)+"/confirm", owner,
+		`{"api_model_id":"vendor-model-b"}`)
+	assert.Equal(t, http.StatusNotFound, rec.Code, "已拒绝的候选不得再被确认")
+
+	// 批量匹配：把所有**归一化后同名**的待确认候选一次确认（此处同名两条已被归一化为一条，故为 0 或 1）
+	require.NoError(t, apigxmodel.RecordAliasCandidate(env.db, apigxmodel.AliasScopePlatform, 0, 0, "bulk-name-x"))
+	rec, body = env.do(t, http.MethodPost, "/api/model-catalog/bulk-confirm", owner,
+		`{"normalized_model_id":"bulk-name-x","api_model_id":"bulk-name-x"}`)
+	require.Equal(t, http.StatusOK, rec.Code, rec.Body.String())
+	affected := body["data"].(map[string]any)["confirmed"].(float64)
+	assert.EqualValues(t, 1, affected, "批量匹配应确认同名候选")
+
+	// 批量确认后，解析就通了（只认已确认）
+	canonical, okModel, err := apigxmodel.ResolveCanonicalModel(env.db, "BULK-NAME-X")
+	require.NoError(t, err)
+	require.True(t, okModel)
+	assert.Equal(t, "bulk-name-x", canonical.APIModelID)
+}
