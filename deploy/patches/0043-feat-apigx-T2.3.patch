diff --git a/apigx/model/repo_fx.go b/apigx/model/repo_fx.go
new file mode 100644
index 0000000..b1faf97
--- /dev/null
+++ b/apigx/model/repo_fx.go
@@ -0,0 +1,123 @@
+package apigxmodel
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/QuantumNous/new-api/common"
+	"gorm.io/gorm"
+)
+
+// 汇率快照（`apigx_fx_rates`，T2.3）。
+//
+// # 为什么必须"存下来"而不是每次现查
+//
+// 计划书验收要求：**非美元价格按保存的汇率归一**、且**历史记录不随汇率更新改写**。
+// 价格规则在写入时就带上 `FxRateID` + `FxRateMicro`，因此：
+//   - 汇率后来怎么变，都不会改变已落库的历史价格；
+//   - 事后能回答"当时用的是哪一次汇率"（凭 `FxRateID` 回溯）。
+//
+// # 方向只有一个，避免歧义
+//
+// `ConversionDirection = 0` 固定含义：**USD = quote / rate**
+// （`RateMicro` 表示 1 USD 等于多少原币：7.123456 CNY → 7123456）。
+// 只有一种方向，就不存在"这次是乘还是除"的口径分歧。
+
+// FxDirectionUSDEqualsQuoteDivRate 是唯一支持的换算方向。
+const FxDirectionUSDEqualsQuoteDivRate int = 0
+
+// ErrNoFxRate 表示没有可用的汇率。
+//
+// 调用方**必须**把它当成"USD 价格未知"处理——绝不能退回 1:1，
+// 那会把 7.2 CNY 当成 7.2 USD，属于静默的严重错价。
+var ErrNoFxRate = errors.New("apigxmodel: no fx rate for currency")
+
+// CreateFxRateSnapshot 追加一条汇率快照，并**封版**上一条（单向，只允许一次）。
+//
+// 封版不是可选的：同一币种若同时存在两条生效汇率，"用哪一条"就变成未定义行为。
+func CreateFxRateSnapshot(db *gorm.DB, rate *FxRate) error {
+	if db == nil || rate == nil {
+		return fmt.Errorf("%w: rate is required", ErrInvalidArgument)
+	}
+	if len(rate.QuoteCurrency) != 3 {
+		return fmt.Errorf("%w: quote currency must be a 3-letter code", ErrInvalidArgument)
+	}
+	if rate.QuoteCurrency == "USD" {
+		// USD 对自己不需要汇率；允许写入会让"1 USD = ? USD"出现两种答案
+		return fmt.Errorf("%w: USD does not need an fx rate", ErrInvalidArgument)
+	}
+	if rate.RateMicro <= 0 {
+		return fmt.Errorf("%w: rate must be positive", ErrInvalidArgument)
+	}
+	if rate.BaseCurrency == "" {
+		rate.BaseCurrency = "USD"
+	}
+	if rate.BaseCurrency != "USD" {
+		return fmt.Errorf("%w: base currency must be USD", ErrInvalidArgument)
+	}
+	if rate.ConversionDirection != FxDirectionUSDEqualsQuoteDivRate {
+		return fmt.Errorf("%w: unsupported conversion direction %d", ErrInvalidArgument, rate.ConversionDirection)
+	}
+	if rate.EffectiveFrom == 0 {
+		rate.EffectiveFrom = common.GetTimestamp()
+	}
+	rate.CreatedAt = common.GetTimestamp()
+
+	return db.Transaction(func(tx *gorm.DB) error {
+		// 封版上一条（EffectiveTo == 0 的那条）
+		sealErr := tx.Model(&FxRate{}).
+			Where("quote_currency = ? AND effective_to = 0", rate.QuoteCurrency).
+			Update("effective_to", rate.EffectiveFrom).Error
+		if sealErr != nil {
+			return sealErr
+		}
+		return tx.Create(rate).Error
+	})
+}
+
+// GetEffectiveFxRate 取某币种在给定时刻生效的汇率。没有则返回 `ErrNoFxRate`。
+func GetEffectiveFxRate(db *gorm.DB, quoteCurrency string, at int64) (*FxRate, error) {
+	if db == nil || len(quoteCurrency) != 3 {
+		return nil, fmt.Errorf("%w: quote currency is required", ErrInvalidArgument)
+	}
+	if at == 0 {
+		at = common.GetTimestamp()
+	}
+	var rate FxRate
+	err := db.Where("quote_currency = ? AND base_currency = ? AND effective_from <= ?",
+		quoteCurrency, "USD", at).
+		Where("effective_to = 0 OR effective_to > ?", at).
+		Order("effective_from DESC").First(&rate).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrNoFxRate
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &rate, nil
+}
+
+// QuoteToUSDMicro 按给定汇率把原币金额（微单位）换算成 USD（微单位）。
+//
+// 方向依据模型注释：`USD = quote / rate`。汇率缺失/非法时返回 `ok=false`——
+// **绝不退回 1:1**。
+func QuoteToUSDMicro(rate *FxRate, quoteMicro int64) (usdMicro int64, ok bool) {
+	if rate == nil || rate.RateMicro <= 0 {
+		return 0, false
+	}
+	if rate.ConversionDirection != FxDirectionUSDEqualsQuoteDivRate {
+		return 0, false
+	}
+	return quoteMicro * 1_000_000 / rate.RateMicro, true
+}
+
+// USDToQuoteMicro 是 `QuoteToUSDMicro` 的反向换算（USD = quote / rate ⇒ quote = USD × rate）。
+func USDToQuoteMicro(rate *FxRate, usdMicro int64) (quoteMicro int64, ok bool) {
+	if rate == nil || rate.RateMicro <= 0 {
+		return 0, false
+	}
+	if rate.ConversionDirection != FxDirectionUSDEqualsQuoteDivRate {
+		return 0, false
+	}
+	return usdMicro * rate.RateMicro / 1_000_000, true
+}
diff --git a/apigx/model/repo_price_test.go b/apigx/model/repo_price_test.go
index 344b6ec..80855ee 100644
--- a/apigx/model/repo_price_test.go
+++ b/apigx/model/repo_price_test.go
@@ -317,3 +317,108 @@ func TestIngestNonUSDPriceUsesSavedFxRate(t *testing.T) {
 	_, usable = EffectiveUSDUnitPriceMicro(rule, &items[0])
 	assert.False(t, usable, "缺汇率时 USD 价格必须显式未知，而不是 0")
 }
+
+// ---- 汇率快照（T2.3） ----
+
+// 汇率快照只追加且封版上一条：历史价格不会因为汇率更新而改变。
+func TestFxRateSnapshotSealsPreviousVersion(t *testing.T) {
+	db := newRepoDB(t)
+
+	first := &FxRate{QuoteCurrency: "CNY", RateMicro: 7_200_000, EffectiveFrom: 1000,
+		SourceLabel: "admin", ConversionDirection: FxDirectionUSDEqualsQuoteDivRate}
+	require.NoError(t, CreateFxRateSnapshot(db, first))
+
+	// 取到第一条
+	rate, err := GetEffectiveFxRate(db, "CNY", 1500)
+	require.NoError(t, err)
+	assert.EqualValues(t, 7_200_000, rate.RateMicro)
+
+	// 追加第二条（汇率变动）：第一条应被封版
+	second := &FxRate{QuoteCurrency: "CNY", RateMicro: 7_400_000, EffectiveFrom: 2000,
+		SourceLabel: "admin", ConversionDirection: FxDirectionUSDEqualsQuoteDivRate}
+	require.NoError(t, CreateFxRateSnapshot(db, second))
+
+	// 历史时刻仍取到**当时**的汇率（历史不被改写）
+	rate, err = GetEffectiveFxRate(db, "CNY", 1500)
+	require.NoError(t, err)
+	assert.EqualValues(t, 7_200_000, rate.RateMicro, "历史时刻必须取到当时生效的汇率")
+	assert.EqualValues(t, first.ID, rate.ID)
+
+	// 当前时刻取到新汇率
+	rate, err = GetEffectiveFxRate(db, "CNY", 2500)
+	require.NoError(t, err)
+	assert.EqualValues(t, 7_400_000, rate.RateMicro)
+
+	// 同一币种任何时刻**只有一条**生效，避免"用哪条"变成未定义
+	var active int64
+	require.NoError(t, db.Model(&FxRate{}).Where("quote_currency = ? AND effective_to = 0", "CNY").Count(&active).Error)
+	assert.EqualValues(t, 1, active)
+}
+
+// 没有汇率时必须报"未知"，**绝不退回 1:1**——否则 7.2 CNY 会被当成 7.2 USD。
+func TestFxRateMissingIsNotOneToOne(t *testing.T) {
+	db := newRepoDB(t)
+
+	_, err := GetEffectiveFxRate(db, "JPY", 0)
+	assert.ErrorIs(t, err, ErrNoFxRate)
+
+	// 换算接口对 nil/非法汇率一律返回 ok=false，而不是拿 1:1 硬算
+	usd, ok := QuoteToUSDMicro(nil, 1_000_000)
+	assert.False(t, ok)
+	assert.Zero(t, usd)
+
+	usd, ok = QuoteToUSDMicro(&FxRate{RateMicro: 0}, 1_000_000)
+	assert.False(t, ok)
+
+	// 方向不对也拒绝（防止"乘还是除"的口径分歧被悄悄绕过）
+	usd, ok = QuoteToUSDMicro(&FxRate{RateMicro: 7_200_000, ConversionDirection: 99}, 7_200_000)
+	assert.False(t, ok)
+}
+
+// 换算方向与数值：USD = quote / rate；反向 quote = USD × rate。
+func TestFxRateConversionDirection(t *testing.T) {
+	rate := &FxRate{QuoteCurrency: "CNY", RateMicro: 7_200_000, ConversionDirection: FxDirectionUSDEqualsQuoteDivRate}
+
+	// 7200000 微人民币 ÷ 7.2 = 1000000 微美元（即 1 USD）
+	usd, ok := QuoteToUSDMicro(rate, 7_200_000)
+	require.True(t, ok)
+	assert.EqualValues(t, 1_000_000, usd)
+
+	// 反向：1 USD → 7.2 CNY
+	quote, ok := USDToQuoteMicro(rate, 1_000_000)
+	require.True(t, ok)
+	assert.EqualValues(t, 7_200_000, quote)
+
+	// 往返一致（取整误差为 0）
+	back, ok := QuoteToUSDMicro(rate, quote)
+	require.True(t, ok)
+	assert.EqualValues(t, 1_000_000, back)
+}
+
+// 非法汇率输入被拒（含"给 USD 配汇率"这种会让 1 USD = ? USD 出现两种答案的情况）。
+func TestCreateFxRateRejectsInvalidInput(t *testing.T) {
+	db := newRepoDB(t)
+	base := func() *FxRate {
+		return &FxRate{QuoteCurrency: "CNY", RateMicro: 7_200_000, ConversionDirection: FxDirectionUSDEqualsQuoteDivRate}
+	}
+
+	bad := base()
+	bad.QuoteCurrency = "CN"
+	assert.ErrorIs(t, CreateFxRateSnapshot(db, bad), ErrInvalidArgument)
+
+	bad = base()
+	bad.QuoteCurrency = "USD"
+	assert.ErrorIs(t, CreateFxRateSnapshot(db, bad), ErrInvalidArgument, "USD 对自己不需要汇率")
+
+	bad = base()
+	bad.RateMicro = 0
+	assert.ErrorIs(t, CreateFxRateSnapshot(db, bad), ErrInvalidArgument)
+
+	bad = base()
+	bad.BaseCurrency = "EUR"
+	assert.ErrorIs(t, CreateFxRateSnapshot(db, bad), ErrInvalidArgument)
+
+	bad = base()
+	bad.ConversionDirection = 1
+	assert.ErrorIs(t, CreateFxRateSnapshot(db, bad), ErrInvalidArgument)
+}
