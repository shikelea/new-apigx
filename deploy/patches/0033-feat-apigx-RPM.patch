diff --git a/apigx/capacity/capacity_test.go b/apigx/capacity/capacity_test.go
index b70efd9..a171e32 100644
--- a/apigx/capacity/capacity_test.go
+++ b/apigx/capacity/capacity_test.go
@@ -197,3 +197,62 @@ func TestReserveFailsClosedWithoutRedis(t *testing.T) {
 	require.Error(t, err)
 	assert.True(t, errors.Is(err, ErrRedisUnavailable), "错误必须是 ErrRedisUnavailable 以便上层停止准入")
 }
+
+// ---- 窗口计数（RPM/TPM） ----
+
+// 窗口计数只增不减：**请求结束不归还**，否则 RPM 永远数不到 2、限速形同虚设。
+func TestIncrementWindowCountsUpToLimit(t *testing.T) {
+	c := newTestController(t)
+	ctx := context.Background()
+	key := ChannelRPM(4242, MinuteWindow(time.Now()))
+
+	require.NoError(t, c.IncrementWindow(ctx, key, 2, 1, WindowTTL(time.Minute)))
+	require.NoError(t, c.IncrementWindow(ctx, key, 2, 1, WindowTTL(time.Minute)))
+
+	// 第三次超限：必须返回 *ErrExceeded **且不写入**
+	err := c.IncrementWindow(ctx, key, 2, 1, WindowTTL(time.Minute))
+	var exceeded *ErrExceeded
+	require.ErrorAs(t, err, &exceeded)
+	assert.Contains(t, exceeded.Dimension, "rpm")
+
+	count, err := c.WindowCount(ctx, key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 2, count, "超限的那次不得计入")
+}
+
+// 计数随窗口 TTL 自动过期：这是"窗口"语义的实现方式（不需要额外清理任务）。
+func TestWindowCountExpires(t *testing.T) {
+	c := newTestController(t)
+	ctx := context.Background()
+	key := ChannelRPM(4243, MinuteWindow(time.Now()))
+
+	require.NoError(t, c.IncrementWindow(ctx, key, 5, 1, 1*time.Second))
+	count, err := c.WindowCount(ctx, key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 1, count)
+
+	time.Sleep(1200 * time.Millisecond)
+	count, err = c.WindowCount(ctx, key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 0, count, "窗口结束后计数必须自动消失")
+}
+
+// 参数校验：非法入参不得静默通过（否则限速会被配置错值悄悄关掉）。
+func TestIncrementWindowRejectsInvalidInput(t *testing.T) {
+	c := newTestController(t)
+	ctx := context.Background()
+	key := ChannelRPM(4244, MinuteWindow(time.Now()))
+
+	require.Error(t, c.IncrementWindow(ctx, "", 1, 1, time.Minute))
+	require.Error(t, c.IncrementWindow(ctx, key, 1, 0, time.Minute), "累加量必须为正")
+	require.Error(t, c.IncrementWindow(ctx, key, -1, 1, time.Minute), "上限不得为负")
+	require.Error(t, c.IncrementWindow(ctx, key, 1, 1, 0), "TTL 必须为正")
+}
+
+// 不同窗口使用不同的 key，因此跨窗口互不影响（按分钟分桶）。
+func TestWindowKeysAreBucketedByMinute(t *testing.T) {
+	now := time.Now()
+	first := ChannelRPM(4245, MinuteWindow(now))
+	second := ChannelRPM(4245, MinuteWindow(now.Add(2*time.Minute)))
+	assert.NotEqual(t, first, second, "不同分钟必须落在不同的计数 key 上")
+}
diff --git a/apigx/capacity/window.go b/apigx/capacity/window.go
new file mode 100644
index 0000000..c2a755c
--- /dev/null
+++ b/apigx/capacity/window.go
@@ -0,0 +1,85 @@
+package capacity
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+)
+
+// 窗口计数（RPM/TPM 用）。
+//
+// # 为什么不能沿用「租约」模型
+//
+// 并发槽位是**请求结束就归还**的（`Reserve` / `Release` 成对出现）；
+// 而速率计数必须在**整个窗口内保留**——如果请求结束时把它减回去，RPM 就永远数不到 2，
+// 限速形同虚设。因此这里提供一个只增不减的原语：计数随窗口 TTL 自动过期。
+//
+// 代价是：**准入之后才失败的请求也会占用额度**。这对限速而言是正确的语义
+// （它确实向上游发出过请求），因此不需要补偿。
+
+// windowScript 原子地「先判断再累加」：计数不超过上限才累加，并刷新窗口 TTL。
+//
+// KEYS[1] = 窗口计数 key
+// ARGV[1] = 上限，ARGV[2] = 本次累加量，ARGV[3] = TTL（秒）
+// 返回 1 表示已计入；0 表示会超限、未计入（**不做任何写入**）。
+const windowScript = `
+local key = KEYS[1]
+local limit = tonumber(ARGV[1])
+local amount = tonumber(ARGV[2])
+local ttl = tonumber(ARGV[3])
+local current = tonumber(redis.call('GET', key) or '0')
+if current + amount > limit then
+  return 0
+end
+redis.call('INCRBY', key, amount)
+redis.call('EXPIRE', key, ttl)
+return 1
+`
+
+// IncrementWindow 在给定窗口内累加计数；超限时返回 *ErrExceeded 且**不做任何写入**。
+//
+// key 应由 `ChannelRPM` / `ChannelTPM` 之类的构造器生成（其中包含窗口编号），
+// ttl 应当略大于窗口长度，保证窗口结束后计数自动消失。
+func (c *Controller) IncrementWindow(ctx context.Context, key string, limit, amount int64, ttl time.Duration) error {
+	if err := c.available(); err != nil {
+		return err
+	}
+	if key == "" {
+		return errors.New("capacity: window key is required")
+	}
+	if amount <= 0 {
+		return fmt.Errorf("capacity: window amount must be positive (got %d)", amount)
+	}
+	if limit < 0 {
+		return fmt.Errorf("capacity: window limit must not be negative (got %d)", limit)
+	}
+	if ttl <= 0 {
+		return fmt.Errorf("capacity: window ttl must be positive (got %s)", ttl)
+	}
+
+	res, err := c.window.Run(ctx, c.rdb, []string{c.counterKey(key)},
+		limit, amount, int64(ttl/time.Second)).Result()
+	if err != nil {
+		return err
+	}
+	if code, _ := res.(int64); code != 1 {
+		return &ErrExceeded{Dimension: key}
+	}
+	return nil
+}
+
+// WindowTTL 返回给定窗口长度对应的计数存活时长（窗口长度 + 一倍余量）。
+//
+// 留余量是为了避免边界抖动：窗口刚切换时旧 key 立即消失会让"上一分钟"的统计不可查。
+func WindowTTL(window time.Duration) time.Duration {
+	if window <= 0 {
+		window = time.Minute
+	}
+	return window * 2
+}
+
+// WindowCount 读取某窗口计数当前的累加值（运维与验收脚本用；不存在即 0）。
+func (c *Controller) WindowCount(ctx context.Context, key string) (int64, error) {
+	return c.Usage(ctx, key)
+}
