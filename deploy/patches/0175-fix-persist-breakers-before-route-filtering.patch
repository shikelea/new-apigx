Subject: [PATCH] fix: persist breakers before route filtering

---
 apigx/relayhook/route_strategy.go      | 13 +++++++
 apigx/relayhook/route_strategy_test.go | 24 +++++++++++++
 apigx/routing/assemble.go              | 14 ++++++--
 apigx/routing/decide_test.go           | 50 ++++++++++++++++++++++++++
 4 files changed, 98 insertions(+), 3 deletions(-)

diff --git a/apigx/relayhook/route_strategy.go b/apigx/relayhook/route_strategy.go
index 949f92a..32b50f0 100644
--- a/apigx/relayhook/route_strategy.go
+++ b/apigx/relayhook/route_strategy.go
@@ -100,6 +100,19 @@ func computeEligibleBaseChannels(db *gorm.DB, modelName string, strategy routing
 		if routing.EvaluateBreaker(candidates[i].Quality, now, routing.DefaultBreakerConfig()).State == routing.BreakerOpen {
 			candidates[i].Allowed = false
 			candidates[i].ExcludeReason = routing.ExcludeBreakerOpen
+			// The strategy filter runs before New API chooses a base channel. Once
+			// this quality verdict excludes the source, CheckBreakerAllows will no
+			// longer see that source and cannot establish durable recovery ownership.
+			// Persist and project the open breaker at the decision boundary instead.
+			if breakerEnabled() {
+				blocked, blockErr := apigxmodel.BreakerProbeBlocksTraffic(db, candidates[i].OfferingID)
+				if blockErr != nil || !blocked {
+					baseChannelID := baseChannelIDForShareChannel(db, candidates[i].ShareChannelID)
+					if baseChannelID > 0 {
+						syncBreakerMarks(db, baseChannelID, candidates[i].OfferingID, true)
+					}
+				}
+			}
 		}
 	}
 	decision, err := routing.Decide(strategy, candidates, routing.DefaultOptions())
diff --git a/apigx/relayhook/route_strategy_test.go b/apigx/relayhook/route_strategy_test.go
index ed0a4bd..36d2455 100644
--- a/apigx/relayhook/route_strategy_test.go
+++ b/apigx/relayhook/route_strategy_test.go
@@ -71,3 +71,27 @@ func TestComputeEligibleBaseChannelsUsesAutoQualityRanking(t *testing.T) {
 	assert.Empty(t, computeEligibleBaseChannels(env.db, "breaker-model", routing.StrategyAuto, map[int64]struct{}{}),
 		"没有授权供给时必须保持空集合，不能回退到底座随机")
 }
+
+func TestComputeEligibleBaseChannelsPersistsOpenBreakerBeforeNativeSelection(t *testing.T) {
+	env := newBreakerTestEnv(t)
+	t.Setenv("APIGX_BREAKER_ENABLED", "true")
+	require.NoError(t, env.db.Model(&apigxmodel.ModelOffering{}).Where("id = ?", env.offeringID).
+		Update("status", apigxmodel.OfferingStatusPublished).Error)
+	require.NoError(t, env.db.Model(&apigxmodel.ShareGroup{}).Where("id = ?", env.shareChannel.ShareGroupID).
+		Update("publish_status", apigxmodel.ShareGroupPublishPublished).Error)
+	env.recordFailures(t, 20)
+
+	allowed := map[int64]struct{}{env.offeringID: {}}
+	assert.Empty(t, computeEligibleBaseChannels(
+		env.db, "breaker-model", routing.StrategyAuto, allowed,
+	))
+
+	var state apigxmodel.BreakerProbeState
+	require.NoError(t, env.db.Where("offering_id = ?", env.offeringID).First(&state).Error)
+	assert.Equal(t, apigxmodel.BreakerProbeStateOpen, state.State)
+	assert.EqualValues(t, env.baseChannelID, state.BaseChannelID)
+
+	var base basemodel.Channel
+	require.NoError(t, env.db.Where("id = ?", env.baseChannelID).First(&base).Error)
+	assert.Equal(t, common.ChannelStatusAutoDisabled, base.Status)
+}
