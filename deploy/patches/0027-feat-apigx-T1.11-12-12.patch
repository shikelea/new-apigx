 )
@@ -51,6 +52,11 @@ func Register(r *gin.RouterGroup, db *gorm.DB) {
 		channels.PUT("/:id/capacity-policy", h.setChannelCapacityPolicy)
 	}
 
+	usage := r.Group("/usage")
