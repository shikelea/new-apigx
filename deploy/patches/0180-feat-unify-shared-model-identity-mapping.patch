diff --git a/web/src/features/share/components/model-mapping-dialog.tsx b/web/src/features/share/components/model-mapping-dialog.tsx
new file mode 100644
index 0000000..7d90b2a
--- /dev/null
+++ b/web/src/features/share/components/model-mapping-dialog.tsx
@@ -0,0 +1,156 @@
