+import { retentionDeadlineUnix } from '../lib/retention'
+
+const DAY = 24 * 60 * 60
+
+describe('保留到期时刻', () => {
+  it('从完成时刻起算，按天数顺延', () => {
+    expect(retentionDeadlineUnix(1_789_000_000, 7)).toBe(1_789_000_000 + 7 * DAY)
+  })
