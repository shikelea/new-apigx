+func factByDimension(t *testing.T, facts []UsageFact, dimension int) UsageFact {
+	t.Helper()
+	for _, fact := range facts {
+		if fact.Dimension == dimension {
+			return fact
+		}
+	}
+	t.Fatalf("missing usage fact dimension %d", dimension)
+	return UsageFact{}
