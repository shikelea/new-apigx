diff --git a/apigx/relayhook/capacity_hook.go b/apigx/relayhook/capacity_hook.go
index 5840b3c..0dffd88 100644
--- a/apigx/relayhook/capacity_hook.go
+++ b/apigx/relayhook/capacity_hook.go
@@ -382,6 +382,10 @@ func AcquireForAttempt(c *gin.Context, channelID int) bool {
 	}
 	if lease != nil {
 		c.Set(leaseContextKey, lease)
+		// 顺带刷新"哪些 Key 已满载"（T2.6）：让底座下次选 Key 时**跳过**满载的那把，
+		// 而不是把请求交给它再由准入拒绝。函数内部按渠道节流（默认 10 秒），
+		// 因此不会给每请求增加 N 次计数读取。
+		RefreshKeySaturation(channelpool.CurrentDB(), channelID)
 		// **持久记录出站尝试**（计划书 §9.2 要求的执行顺序）：进程若在中途退出，
 		// 事后就能凭这条记录知道"当时确实占用了容量"，进而做对账补偿。
 		// 记录失败不影响请求本身——容量租约仍在，TTL 与对账都会兜住。
diff --git a/apigx/relayhook/key_saturation.go b/apigx/relayhook/key_saturation.go
new file mode 100644
index 0000000..10fee74
--- /dev/null
+++ b/apigx/relayhook/key_saturation.go
@@ -0,0 +1,162 @@
+package relayhook
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	"github.com/QuantumNous/new-api/apigx/channelpool"
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/QuantumNous/new-api/common"
+	basemodel "github.com/QuantumNous/new-api/model"
+	"gorm.io/gorm"
+)
+
+// Key 级"剩余容量"的运行时刷新（T2.6 最后一块）。
+//
+// # 与"容量准入"的分工
+//
+// 容量准入（`AcquireForAttempt`）解决"这次请求能不能占用"；本函数解决
+// **"底座下次选 Key 时要不要跳过它"**。两者都要，原因很实际：只有准入的话，
+// 底座仍会把请求交给已满载的 Key，然后由准入拒绝——表现为"明明还有另一把可用的 Key，
+// 请求却被拒"（用户在容量充足时看到 429）。
+//
+// 实现直接复用已有机制：`SaturatedKeyIndexes` 判定 + `MergeKeyStatusList` 合并
+// （只回收我们自己写的格子），底座的 `GetNextEnabledKey` 会跳过被标记的索引。
+//
+// # 为什么要节流
+//
+// 判定要按 Key 读一次 Redis 计数，属每请求路径；因此按渠道做**短间隔节流**（默认 10 秒）。
+// 容量状态按秒级变化，10 秒滞后可接受，而省下的是每请求 N 次计数读取。
+
+// keySaturationRefreshInterval 是同一渠道两次刷新之间的最小间隔。
+var keySaturationRefreshInterval = 10 * time.Second
+
+var (
+	keySaturationMu   sync.Mutex
+	keySaturationLast = map[int]time.Time{}
+)
+
+// ResetKeySaturationThrottleForTest 清空节流记录（测试用）。
+func ResetKeySaturationThrottleForTest() {
+	keySaturationMu.Lock()
+	keySaturationLast = map[int]time.Time{}
+	keySaturationMu.Unlock()
+}
+
+// RefreshKeySaturation 依据各把 Key 的当前占用，刷新底座渠道状态表里的"满载"标记。
+//
+// 读不到计数时**不标记**（与熔断的取舍一致）：统计读取失败不代表 Key 满了，
+// 因读取失败把可用 Key 摘掉，比"偶尔多用一把"更糟。
+func RefreshKeySaturation(db *gorm.DB, baseChannelID int) {
+	if db == nil || baseChannelID <= 0 {
+		return
+	}
+	if !throttleAllows(baseChannelID, time.Now()) {
+		return
+	}
+
+	shareChannelID, ok := channelpool.ShareChannelIDByBase(db, baseChannelID)
+	if !ok {
+		return // 平台自建渠道不参与
+	}
+	loads := keyLoadsForChannel(db, baseChannelID, shareChannelID)
+	if len(loads) == 0 {
+		return // 没有配置任何 Key 级上限：无"满载"可言
+	}
+	applyKeySaturationMarks(db, baseChannelID, channelpool.SaturatedKeyIndexes(loads))
+}
+
+// throttleAllows 判断该渠道是否到了可以再次刷新的时间。
+func throttleAllows(baseChannelID int, now time.Time) bool {
+	keySaturationMu.Lock()
+	defer keySaturationMu.Unlock()
+	if last, ok := keySaturationLast[baseChannelID]; ok && now.Sub(last) < keySaturationRefreshInterval {
+		return false
+	}
+	keySaturationLast[baseChannelID] = now
+	return true
+}
+
+// keyLoadsForChannel 组装该渠道各 Key 索引的占用与上限。
+//
+// 上限取自**每把 Key 当前生效的策略链**（与准入用的是同一套解析），
+// 保证"标记"与"准入"不会出现两套口径。
+func keyLoadsForChannel(db *gorm.DB, baseChannelID int, shareChannelID int64) []channelpool.KeyLoad {
+	if common.RDB == nil {
+		return nil
+	}
+	projection, err := channelpool.MapBaseKeyIndexesCached(db, shareChannelID)
+	if err != nil || projection == nil || projection.KeyCount <= 0 {
+		return nil
+	}
+	cfg := getConfig()
+	if cfg.UpstreamKeyLimit <= 0 && cfg.UpstreamAccountLimit <= 0 {
+		// 没有配置任何 Key/账户级上限：不必逐 Key 读计数（省掉每请求 N 次 Redis 往返）
+		return nil
+	}
+
+	ctrl := capacity.New(common.RDB)
+	limits := channelpool.KeyCapacityLimits{
+		UpstreamKeyLimit:     cfg.UpstreamKeyLimit,
+		UpstreamAccountLimit: cfg.UpstreamAccountLimit,
+	}
+	loads := make([]channelpool.KeyLoad, 0, projection.KeyCount)
+	for index := range projection.KeyCount {
+		dims := channelpool.BuildKeyCapacityDimensions(db, baseChannelID, index, limits)
+		if len(dims) == 0 {
+			continue
+		}
+		used, usageErr := ctrl.Usage(context.Background(), dims[0].Key)
+		if usageErr != nil {
+			continue // 读不到就不标记（见函数注释）
+		}
+		loads = append(loads, channelpool.KeyLoad{Index: index, InUse: used, Limit: dims[0].Limit})
+	}
+	return loads
+}
+
+// applyKeySaturationMarks 把饱和索引并入底座状态表（只回收我们自己的标记）。
+func applyKeySaturationMarks(db *gorm.DB, baseChannelID int, saturated []int) {
+	var channel basemodel.Channel
+	if err := db.Where("id = ?", baseChannelID).First(&channel).Error; err != nil {
+		return
+	}
+	if !channel.ChannelInfo.IsMultiKey || channel.ChannelInfo.MultiKeySize <= 0 {
+		return
+	}
+	current := channel.ChannelInfo.MultiKeyStatusList
+	ours := make([]int, 0, len(current))
+	for index, status := range current {
+		if status == apigxmodel.StatusCapacitySaturated {
+			ours = append(ours, index)
+		}
+	}
+	next := channelpool.MergeKeyStatusList(current, ours, saturated, apigxmodel.StatusCapacitySaturated)
+	if equalStatusLists(current, next) {
+		return
+	}
+	channel.ChannelInfo.MultiKeyStatusList = next
+	if err := db.Model(&basemodel.Channel{}).Where("id = ?", baseChannelID).
+		Update("channel_info", channel.ChannelInfo).Error; err != nil {
+		common.SysError("apigx capacity: update key saturation marks failed: " + err.Error())
+		return
+	}
+	if refreshed, err := basemodel.GetChannelById(baseChannelID, true); err == nil && refreshed != nil {
+		basemodel.CacheUpdateChannel(refreshed)
+	}
+}
+
+// equalStatusLists 判断两份状态表是否等价（nil 与空视为相同）。
+func equalStatusLists(a, b map[int]int) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for index, status := range a {
+		if other, ok := b[index]; !ok || other != status {
+			return false
+		}
+	}
+	return true
+}
diff --git a/apigx/relayhook/key_saturation_test.go b/apigx/relayhook/key_saturation_test.go
new file mode 100644
index 0000000..032d4b3
--- /dev/null
+++ b/apigx/relayhook/key_saturation_test.go
@@ -0,0 +1,111 @@
+package relayhook
+
+import (
+	"path/filepath"
+	"testing"
+	"time"
+
+	apigxmodel "github.com/QuantumNous/new-api/apigx/model"
+	"github.com/QuantumNous/new-api/common"
+	basemodel "github.com/QuantumNous/new-api/model"
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// Key 级"剩余容量"的运行时刷新（T2.6 最后一块）。
+//
+// 这里测的都是**确定性**行为：给定"哪些索引满载"，状态表该不该有标记是确定的——
+// 因此单测比并发 E2E 更能说明问题（并发场景里还混着准入拒绝的影响，两种原因分不开）。
+// Redis 计数到"哪些索引满载"的换算在 `SaturatedKeyIndexes` 里，已有自己的用例。
+
+func setupKeySaturationEnv(t *testing.T, keyCount int) (*gorm.DB, int) {
+	t.Helper()
+	dsn := filepath.Join(t.TempDir(), "apigx_key_sat_test.db")
+	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{})
+	require.NoError(t, err)
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	require.NoError(t, apigxmodel.Migrate(db))
+	require.NoError(t, db.AutoMigrate(&basemodel.Channel{}))
+	previousBaseDB := basemodel.DB
+	basemodel.DB = db
+	t.Cleanup(func() { basemodel.DB = previousBaseDB })
+
+	baseChannelID := int(910000 + time.Now().UnixNano()%10000)
+	priority := int64(0)
+	weight := uint(0)
+	require.NoError(t, db.Create(&basemodel.Channel{
+		Id: baseChannelID, Name: "饱和度底座", Key: "sk-a\nsk-b", Status: common.ChannelStatusEnabled,
+		Priority: &priority, Weight: &weight,
+		ChannelInfo: basemodel.ChannelInfo{
+			IsMultiKey: true, MultiKeySize: keyCount,
+			// 索引 0 是**底座自己**的禁用原因：我们任何时候都不得动它
+			MultiKeyStatusList: map[int]int{0: common.ChannelStatusAutoDisabled},
+		},
+	}).Error)
+	return db, baseChannelID
+}
+
+// 满载的索引被标记；恢复后被回收；**底座自己的禁用原因始终不动**。
+func TestApplyKeySaturationMarksAndClears(t *testing.T) {
+	db, baseChannelID := setupKeySaturationEnv(t, 2)
+
+	applyKeySaturationMarks(db, baseChannelID, []int{1})
+	var marked basemodel.Channel
+	require.NoError(t, db.Where("id = ?", baseChannelID).First(&marked).Error)
+	assert.Equal(t, apigxmodel.StatusCapacitySaturated, marked.ChannelInfo.MultiKeyStatusList[1],
+		"满载的索引应被标记（底座据此跳过该 Key，而不是把请求交给它再拒绝）")
+	assert.Equal(t, common.ChannelStatusAutoDisabled, marked.ChannelInfo.MultiKeyStatusList[0],
+		"底座自己的禁用原因不得被我们抹掉")
+
+	// 容量释放 → 只回收我们自己的标记
+	applyKeySaturationMarks(db, baseChannelID, nil)
+	var restored basemodel.Channel
+	require.NoError(t, db.Where("id = ?", baseChannelID).First(&restored).Error)
+	_, stillMarked := restored.ChannelInfo.MultiKeyStatusList[1]
+	assert.False(t, stillMarked, "容量恢复后应回收我们的标记（缺失即启用）")
+	assert.Equal(t, common.ChannelStatusAutoDisabled, restored.ChannelInfo.MultiKeyStatusList[0],
+		"回收不得波及底座自己的标记")
+}
+
+// 标记未变化时**不写库**（避免每请求都产生一次无意义的写）。
+func TestApplyKeySaturationSkipsRedundantWrite(t *testing.T) {
+	db, baseChannelID := setupKeySaturationEnv(t, 2)
+
+	applyKeySaturationMarks(db, baseChannelID, []int{1})
+	var first basemodel.Channel
+	require.NoError(t, db.Where("id = ?", baseChannelID).First(&first).Error)
+
+	// 再标一次同样的集合：内容等价 → 提前返回（这里用"内容不变"来断言，不依赖写入次数）
+	applyKeySaturationMarks(db, baseChannelID, []int{1})
+	var second basemodel.Channel
+	require.NoError(t, db.Where("id = ?", baseChannelID).First(&second).Error)
+	assert.True(t, equalStatusLists(first.ChannelInfo.MultiKeyStatusList, second.ChannelInfo.MultiKeyStatusList))
+	assert.Equal(t, apigxmodel.StatusCapacitySaturated, second.ChannelInfo.MultiKeyStatusList[1])
+}
+
+// 非多 Key 渠道不标记（没有可标记的条目）。
+func TestApplyKeySaturationSkipsNonMultiKeyChannel(t *testing.T) {
+	db, baseChannelID := setupKeySaturationEnv(t, 0)
+	require.NoError(t, db.Model(&basemodel.Channel{}).Where("id = ?", baseChannelID).
+		Update("channel_info", basemodel.ChannelInfo{IsMultiKey: false}).Error)
+
+	applyKeySaturationMarks(db, baseChannelID, []int{0})
+	var channel basemodel.Channel
+	require.NoError(t, db.Where("id = ?", baseChannelID).First(&channel).Error)
+	assert.False(t, channel.ChannelInfo.IsMultiKey)
+	assert.Empty(t, channel.ChannelInfo.MultiKeyStatusList)
+}
+
+// 节流：同一渠道在间隔内只刷新一次（这是"每请求路径"上必须有的保护）。
+func TestKeySaturationRefreshIsThrottled(t *testing.T) {
+	ResetKeySaturationThrottleForTest()
+	now := time.Now()
+	assert.True(t, throttleAllows(12345, now), "首次应允许")
+	assert.False(t, throttleAllows(12345, now.Add(time.Second)), "间隔内应被节流")
+	assert.True(t, throttleAllows(12345, now.Add(keySaturationRefreshInterval+time.Second)), "超过间隔后应允许")
+	assert.True(t, throttleAllows(54321, now), "不同渠道互不影响")
+}
