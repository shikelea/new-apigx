MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- 能力矩阵新增 verified / not_verified：按计划书"支持范围逐项记录、声明不支持项"要求,
  把**真的跑过的**与**没跑过的**逐项写出(如: 对话的 Gemini 原生路径未联调; 图片编辑与数量 n 未验证;
  向量输入量上限; 重排文档数上限; 语音合成与大小/时长限制; 视频超时路径)
- 用当前二进制复跑五类验收脚本: 对话 5/5 / 图片 4/4 / 向量重排语音 11/11 / 平台侧语义 12/12 / 视频 8/8
- 验收行逐条对照: 对话与图片为真实上游; 向量/重排/语音/视频以底座适配器+替身验证协议与计量并逐项声明;
  支持范围逐项记录(矩阵接口, 界面与文档共用); 视频绑定正确用户与原渠道; 不支持取消明确显示
- 检查: go build ✅ / apigx/api 整包 ✅
---
 apigx/api/capabilities.go | 58 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/apigx/api/capabilities.go b/apigx/api/capabilities.go
index bc668b6..9c34a0a 100644
--- a/apigx/api/capabilities.go
+++ b/apigx/api/capabilities.go
@@ -18,6 +18,10 @@ type capabilityEntry struct {
 	Status      string   `json:"status"`
 	Evidence    string   `json:"evidence"`
 	Limitations []string `json:"limitations,omitempty"`
+	// Verified/NotVerified 按计划书阶段 3 的**逐项验收范围**记录事实：
+	// 哪些子项真的被跑过、哪些没有。声明"没验过"与"验过"同样重要。
+	Verified    []string `json:"verified"`
+	NotVerified []string `json:"not_verified,omitempty"`
 }
 
 // capabilityMatrix 是矩阵本体。改动它时必须同步更新 evidence 与 limitations，
@@ -27,11 +31,31 @@ var capabilityMatrix = []capabilityEntry{
 		Capability: "chat", Endpoints: []string{"/v1/chat/completions", "/v1/messages", "/v1/responses"},
 		Status:   "supported",
 		Evidence: "真实上游端到端 5/5：同步、SSE 流式、工具调用、Anthropic Messages、Responses（含视觉输入）",
+		Verified: []string{
+			"OpenAI Chat Completions 同步与 SSE（真实上游）",
+			"工具调用（真实上游）",
+			"Anthropic Messages（真实上游）",
+			"Responses（真实上游）",
+			"视觉输入（真实上游）",
+		},
+		NotVerified: []string{
+			"Gemini 原生文本路径（未联调）",
+		},
 	},
 	{
 		Capability: "image", Endpoints: []string{"/v1/images/generations", "/v1/images/edits"},
 		Status:   "supported",
 		Evidence: "真实上游端到端：生成 200、用量含配额、非法尺寸 400；尺寸语法与范围已加固（台账 D-021）",
+		Verified: []string{
+			"生成（真实上游，qwen-image-2.0）",
+			"尺寸语法与范围校验（台账 D-021）",
+			"结果访问需鉴权",
+			"计量（用量记录含配额）",
+		},
+		NotVerified: []string{
+			"图片编辑（未与真实上游联调）",
+			"数量参数 n 的上限（未验证）",
+		},
 		Limitations: []string{
 			"上游返回**签名直链**（有效期内持有者可直接访问）：若要求“结果仅授权者可见”，需我方代理或转存",
 		},
@@ -40,21 +64,55 @@ var capabilityMatrix = []capabilityEntry{
 		Capability: "embedding", Endpoints: []string{"/v1/embeddings"},
 		Status:   "supported",
 		Evidence: "复用底座适配器；已验协议往返、usage 计量与规格拒绝",
+		Verified: []string{
+			"批量 embeddings 协议往返",
+			"向量维度",
+			"usage 计量与落库",
+		},
+		NotVerified: []string{
+			"输入量上限（未验证）",
+		},
 	},
 	{
 		Capability: "rerank", Endpoints: []string{"/v1/rerank"},
 		Status:   "supported",
 		Evidence: "复用底座适配器；已验查询/文档往返、计量与空文档拒绝",
+		Verified: []string{
+			"查询/文档列表往返与排序结果",
+			"计量落库",
+			"空文档列表被拒",
+		},
+		NotVerified: []string{
+			"文档数量上限（未验证）",
+		},
 	},
 	{
 		Capability: "audio", Endpoints: []string{"/v1/audio/transcriptions", "/v1/audio/translations", "/v1/audio/speech"},
 		Status:   "supported",
 		Evidence: "复用底座适配器；已验转写往返与计量；缺文件返回 4xx（台账 D-024）",
+		Verified: []string{
+			"转写协议往返与计量落库",
+			"缺少音频文件被拒（4xx，台账 D-024）",
+		},
+		NotVerified: []string{
+			"语音合成（speech）",
+			"上传大小/时长限制",
+		},
 	},
 	{
 		Capability: "video", Endpoints: []string{"/v1/videos", "/v1/videos/:id", "/v1/videos/:id/content", "/v1/videos/:id/cancel"},
 		Status:   "supported",
 		Evidence: "复用底座内置 kling 任务插件：提交/轮询/终态/绑定/跨用户/结果访问 8/8（台账 D-022）",
+		Verified: []string{
+			"提交与轮询到成功终态",
+			"失败终态如实反映",
+			"任务绑定正确用户与原渠道",
+			"跨用户访问被拒",
+			"结果内容访问（授权者取回）",
+		},
+		NotVerified: []string{
+			"超时路径（未构造真实超时）",
+		},
 		Limitations: []string{
 			"**不支持取消**：`/v1/videos/:id/cancel` 返回 404 —— 界面必须显示该能力限制，不得显示“可取消”",
 			"通用任务 API `/v1/tasks` 在本配置下**未启用**（404）",
