diff --git a/service/apigx_budget_guard.go b/service/apigx_budget_guard.go
new file mode 100644
index 0000000..9d68c9b
--- /dev/null
+++ b/service/apigx_budget_guard.go
@@ -0,0 +1,80 @@
+package service
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	"github.com/QuantumNous/new-api/common"
+	"github.com/QuantumNous/new-api/logger"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/gin-gonic/gin"
+)
+
+// APIGX 每日预算维度（T1.7）。
+//
+// # 为什么放在计费会话这一层
+//
+// 预算预留的金额必须是**可执行的**：准入时我们拿得到本次要预扣的额度
+// （底座在创建计费会话前已算出 `preConsumedQuota`），所以直接用它做预留，
+// 不需要凭空估算 token（计划书 §9.2 对 TPM 的告诫同理）。
+//
+// # 与并发/速率的区别
+//
+// 预算计数**在窗口内不归还**（与 RPM 一致）：已花掉的钱不会因为请求失败而"没花过"。
+// 窗口按**UTC 自然日**分桶，TTL 取 48 小时，避免跨时区/跨日边界时统计突然消失。
+//
+// 配置：环境变量 `APIGX_DAILY_BUDGET_MICRO`（微美元），0 表示未配置（不施加约束）。
+
+// dailyBudgetWindow 返回当前 UTC 自然日的桶编号。
+func dailyBudgetWindow(now time.Time) int64 {
+	return now.UTC().Unix() / 86400
+}
+
+// budgetLimitFromEnv 读取部署级预算上限（微美元）。0 = 未配置。
+func budgetLimitFromEnv() int64 {
+	return int64(common.GetEnvOrDefault("APIGX_DAILY_BUDGET_MICRO", 0))
+}
+
+// CheckAPIGXDailyBudget 在计费会话建立前检查并累加使用者当日预算。
+//
+// 返回 nil 表示放行；否则返回应当直接拒绝的错误（**不建立会话**）。
+// 账本不可用时**拒绝**而不是放行：无法安全判断预算时不能继续放量（与容量准入同一原则）。
+func CheckAPIGXDailyBudget(c *gin.Context, relayInfo *relaycommon.RelayInfo, preConsumedQuota int) *types.NewAPIError {
+	limit := budgetLimitFromEnv()
+	if limit <= 0 || relayInfo == nil || relayInfo.UserId <= 0 {
+		return nil
+	}
+	if common.RDB == nil {
+		// 未启用 Redis：无法判断共享预算，按"失败关闭"处理
+		return types.NewErrorWithStatusCode(errors.New("budget ledger unavailable"),
+			types.ErrorCodeQueryDataError, http.StatusServiceUnavailable, types.ErrOptionWithSkipRetry())
+	}
+
+	amount := int64(preConsumedQuota)
+	if amount <= 0 {
+		// 预扣为 0（例如信任额度旁路）时也要**记一次最小值**，
+		// 否则"零成本的请求"会完全绕过每日预算统计。
+		amount = 1
+	}
+
+	ctrl := capacity.New(common.RDB)
+	windowKey := capacity.UserDailyBudgetMicro(int64(relayInfo.UserId), dailyBudgetWindow(time.Now()))
+	if err := ctrl.IncrementWindow(c.Request.Context(), windowKey, limit, amount, 48*time.Hour); err != nil {
+		var exceeded *capacity.ErrExceeded
+		if errors.As(err, &exceeded) {
+			logger.LogWarn(c, fmt.Sprintf("APIGX daily budget exceeded for user %d", relayInfo.UserId))
+			return types.NewErrorWithStatusCode(
+				errors.New("daily budget exceeded"),
+				types.ErrorCodeInsufficientUserQuota, http.StatusForbidden,
+				types.ErrOptionWithSkipRetry(), types.ErrOptionWithNoRecordErrorLog())
+		}
+		common.SysError("apigx budget guard: ledger error: " + err.Error())
+		return types.NewErrorWithStatusCode(errors.New("budget ledger error"),
+			types.ErrorCodeQueryDataError, http.StatusServiceUnavailable, types.ErrOptionWithSkipRetry())
+	}
+	return nil
+}
diff --git a/service/apigx_budget_guard_test.go b/service/apigx_budget_guard_test.go
new file mode 100644
index 0000000..8e7afe4
--- /dev/null
+++ b/service/apigx_budget_guard_test.go
@@ -0,0 +1,144 @@
+package service
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	"github.com/QuantumNous/new-api/common"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	"github.com/gin-gonic/gin"
+	"github.com/go-redis/redis/v8"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// APIGX 每日预算守卫（T1.7）的单元测试。
+//
+// 需要真实 Redis：窗口计数的原子性（"先判断再累加"）无法用 mock 证明。
+//
+//	APIGX_TEST_REDIS_ADDR=127.0.0.1:6379
+func setupBudgetGuard(t *testing.T) *gin.Context {
+	t.Helper()
+	addr := os.Getenv("APIGX_TEST_REDIS_ADDR")
+	if addr == "" {
+		t.Skip("未设置 APIGX_TEST_REDIS_ADDR：预算守卫未在真实 Redis 上验证（不允许当作通过）")
+	}
+	rdb := redis.NewClient(&redis.Options{Addr: addr, DB: 15})
+	require.NoError(t, rdb.Ping(t.Context()).Err(), "连接 Redis 失败")
+	previous := common.RDB
+	common.RDB = rdb
+	t.Cleanup(func() { common.RDB = previous; _ = rdb.Close() })
+
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+	return c
+}
+
+func withBudgetEnv(t *testing.T, micro string) {
+	t.Helper()
+	previous, had := os.LookupEnv("APIGX_DAILY_BUDGET_MICRO")
+	require.NoError(t, os.Setenv("APIGX_DAILY_BUDGET_MICRO", micro))
+	t.Cleanup(func() {
+		if had {
+			_ = os.Setenv("APIGX_DAILY_BUDGET_MICRO", previous)
+		} else {
+			_ = os.Unsetenv("APIGX_DAILY_BUDGET_MICRO")
+		}
+	})
+}
+
+// 预算按「累加金额」判断：累计不超限放行，超出即拒；且**计数不因请求结束而归还**。
+func TestDailyBudgetAccumulatesAndRejects(t *testing.T) {
+	c := setupBudgetGuard(t)
+	withBudgetEnv(t, "100")
+	const userID = 88001
+	cleanup := func() {
+		ctrl := capacity.New(common.RDB)
+		require.NoError(t, ctrl.Drop(context.Background(),
+			capacity.UserDailyBudgetMicro(userID, dailyBudgetWindow(time.Now()))))
+	}
+	cleanup()
+	t.Cleanup(cleanup)
+
+	relayInfo := &relaycommon.RelayInfo{UserId: userID}
+
+	// 60 微美元：0+60 <= 100 → 放行
+	require.Nil(t, CheckAPIGXDailyBudget(c, relayInfo, 60))
+
+	// 再 60：60+60 > 100 → 拒绝（且返回 403，不当成上游故障）
+	err := CheckAPIGXDailyBudget(c, relayInfo, 60)
+	require.NotNil(t, err)
+	assert.Equal(t, http.StatusForbidden, err.StatusCode)
+
+	// 30：60+30 = 90 <= 100 → 放行，证明是**累加**而不是"单次金额超过上限才拒"
+	require.Nil(t, CheckAPIGXDailyBudget(c, relayInfo, 30))
+
+	// 再 30：90+30 > 100 → 拒绝
+	assert.NotNil(t, CheckAPIGXDailyBudget(c, relayInfo, 30))
+}
+
+// 未配置预算（0）时不施加约束——未配置是待补的过渡状态，不是"零预算"。
+func TestDailyBudgetDisabledWhenUnset(t *testing.T) {
+	c := setupBudgetGuard(t)
+	withBudgetEnv(t, "0")
+	relayInfo := &relaycommon.RelayInfo{UserId: 88002}
+	require.Nil(t, CheckAPIGXDailyBudget(c, relayInfo, 1_000_000))
+}
+
+// 预扣为 0 时也要记一次最小量：否则零成本请求会完全绕过预算统计。
+func TestDailyBudgetCountsZeroCostRequests(t *testing.T) {
+	c := setupBudgetGuard(t)
+	withBudgetEnv(t, "2")
+	const userID = 88003
+	cleanup := func() {
+		ctrl := capacity.New(common.RDB)
+		require.NoError(t, ctrl.Drop(context.Background(),
+			capacity.UserDailyBudgetMicro(userID, dailyBudgetWindow(time.Now()))))
+	}
+	cleanup()
+	t.Cleanup(cleanup)
+	relayInfo := &relaycommon.RelayInfo{UserId: userID}
+
+	// 三次零成本请求：每次记 1，第三次应被拒（2 是上限）
+	require.Nil(t, CheckAPIGXDailyBudget(c, relayInfo, 0))
+	require.Nil(t, CheckAPIGXDailyBudget(c, relayInfo, 0))
+	assert.NotNil(t, CheckAPIGXDailyBudget(c, relayInfo, 0), "零成本请求也必须计入每日预算")
+}
+
+// 账本不可用时必须**失败关闭**（拒绝），而不是放行。
+func TestDailyBudgetFailsClosedWithoutRedis(t *testing.T) {
+	c := setupBudgetGuard(t)
+	withBudgetEnv(t, "100")
+	previous := common.RDB
+	common.RDB = nil
+	t.Cleanup(func() { common.RDB = previous })
+
+	err := CheckAPIGXDailyBudget(c, &relaycommon.RelayInfo{UserId: 88004}, 10)
+	require.NotNil(t, err)
+	assert.Equal(t, http.StatusServiceUnavailable, err.StatusCode)
+}
+
+// 不同用户互不影响（预算是**使用者**维度）。
+func TestDailyBudgetIsPerUser(t *testing.T) {
+	c := setupBudgetGuard(t)
+	withBudgetEnv(t, "10")
+	first := &relaycommon.RelayInfo{UserId: 88005}
+	second := &relaycommon.RelayInfo{UserId: 88006}
+	cleanup := func() {
+		ctrl := capacity.New(common.RDB)
+		require.NoError(t, ctrl.Drop(context.Background(),
+			capacity.UserDailyBudgetMicro(88005, dailyBudgetWindow(time.Now())),
+			capacity.UserDailyBudgetMicro(88006, dailyBudgetWindow(time.Now()))))
+	}
+	cleanup()
+	t.Cleanup(cleanup)
+
+	require.Nil(t, CheckAPIGXDailyBudget(c, first, 10))
+	require.Nil(t, CheckAPIGXDailyBudget(c, second, 10), "另一个使用者不应受前者的用量影响")
+}
