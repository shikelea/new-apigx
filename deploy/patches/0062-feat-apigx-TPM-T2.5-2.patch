diff --git a/apigx/relayhook/tpm_adjust.go b/apigx/relayhook/tpm_adjust.go
new file mode 100644
index 0000000..1432a1a
--- /dev/null
+++ b/apigx/relayhook/tpm_adjust.go
@@ -0,0 +1,83 @@
+package relayhook
+
+import (
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+)
+
+// TPM 预留的结算期调整（T2.5 最后一环）。
+//
+// # 问题
+//
+// TPM 预留必须用**可执行的输出上限**（计划书 §9.2），而上限通常远高于实际输出
+// （缺省 8192）。预留后若不调整，渠道的每分钟 token 额度会被"最坏情况"占满，
+// 结果是**明明没用到那么多也被限流**。
+//
+// # 做法
+//
+// 预留时把 {窗口 key, 预留量, TTL} 记在请求上下文里；拿到真实 usage 之后调用
+// `AdjustReservedTPM`，把 `实际 - 预留` 的差额退回去（`capacity.AdjustWindow` 带下限，
+// 重复调用也不会把计数减成负数）。
+//
+// # 为什么挂在消费日志点
+//
+// 底座把最终 usage 暴露到**消费日志参数**里（`summary.PromptTokens/CompletionTokens`），
+// 而那里同时有 gin 上下文——是唯一"两样都齐"的位置。上下文的 token 键只有 prompt 部分，
+// 结算入口只有 quota，都拿不到完整 usage。
+
+// tpmReservationKey 是存放本次请求 TPM 预留信息的上下文键。
+const tpmReservationKey = "apigx_tpm_reservation"
+
+type tpmReservation struct {
+	windowKey string
+	reserved  int64
+	ttl       time.Duration
+}
+
+// storeTPMReservation 记录一次 TPM 预留（供结算期按实际用量调整）。
+func storeTPMReservation(c *gin.Context, reservation tpmReservation) {
+	if c == nil || reservation.windowKey == "" || reservation.reserved <= 0 {
+		return
+	}
+	c.Set(tpmReservationKey, reservation)
+}
+
+// tpmAdjustEnabled 是"结算期按实际用量调整预留"的开关（默认关闭，与其它 APIGX 开关一致）。
+func tpmAdjustEnabled() bool {
+	return common.GetEnvOrDefaultBool("APIGX_TPM_ADJUST_ENABLED", false)
+}
+
+// AdjustReservedTPM 按实际用量把 TPM 预留的差额退回窗口计数。
+//
+// 任何失败只记日志，**不影响请求**——这是旁路性质的记账修正。
+func AdjustReservedTPM(c *gin.Context, actualTokens int64) {
+	if !tpmAdjustEnabled() || c == nil || actualTokens <= 0 {
+		return
+	}
+	value, exists := c.Get(tpmReservationKey)
+	if !exists {
+		return
+	}
+	reservation, ok := value.(tpmReservation)
+	if !ok || reservation.windowKey == "" {
+		return
+	}
+	delta := actualTokens - reservation.reserved
+	if delta == 0 {
+		return
+	}
+	if common.RDB == nil {
+		return
+	}
+	ctrl := capacity.New(common.RDB)
+	if _, err := ctrl.AdjustWindow(c.Request.Context(), reservation.windowKey, delta, reservation.ttl); err != nil {
+		common.SysError("apigx capacity: adjust reserved tpm failed: " + err.Error())
+		return
+	}
+	// 一次性记账：调整过就清掉，避免同一请求被重复调整
+	c.Set(tpmReservationKey, tpmReservation{})
+	common.SysLog("apigx capacity: adjusted reserved tpm by actual usage")
+}
diff --git a/apigx/relayhook/tpm_adjust_test.go b/apigx/relayhook/tpm_adjust_test.go
new file mode 100644
index 0000000..ff58607
--- /dev/null
+++ b/apigx/relayhook/tpm_adjust_test.go
@@ -0,0 +1,103 @@
+package relayhook
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/QuantumNous/new-api/apigx/capacity"
+	"github.com/QuantumNous/new-api/common"
+	"github.com/gin-gonic/gin"
+	"github.com/go-redis/redis/v8"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TPM 预留的结算期调整（T2.5 最后一环）。
+//
+// 这些断言都是**可确定的**：给定预留量与实际用量，窗口计数应落在哪个数值上是确定的。
+
+func setupTPMAdjustEnv(t *testing.T) (*gin.Context, *capacity.Controller) {
+	t.Helper()
+	addr := os.Getenv("APIGX_TEST_REDIS_ADDR")
+	if addr == "" {
+		t.Skip("未设置 APIGX_TEST_REDIS_ADDR：TPM 调整需要真实窗口计数")
+	}
+	rdb := redis.NewClient(&redis.Options{Addr: addr, DB: 15})
+	require.NoError(t, rdb.Ping(t.Context()).Err(), "连接 Redis 失败")
+	previous := common.RDB
+	common.RDB = rdb
+	t.Cleanup(func() { common.RDB = previous; _ = rdb.Close() })
+
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+	return c, capacity.New(rdb)
+}
+
+// 关闭时不做任何调整（默认关闭，与其它 APIGX 开关一致）。
+func TestAdjustReservedTPMDisabledByDefault(t *testing.T) {
+	c, ctrl := setupTPMAdjustEnv(t)
+	t.Setenv("APIGX_TPM_ADJUST_ENABLED", "false")
+
+	key := capacity.ChannelTPM(7701, capacity.MinuteWindow(time.Now()))
+	t.Cleanup(func() { _ = ctrl.Drop(context.Background(), key) })
+	require.NoError(t, ctrl.IncrementWindow(t.Context(), key, 1_000_000, 8202, capacity.WindowTTL(time.Minute)))
+	storeTPMReservation(c, tpmReservation{windowKey: key, reserved: 8202, ttl: capacity.WindowTTL(time.Minute)})
+
+	AdjustReservedTPM(c, 46)
+	count, err := ctrl.WindowCount(t.Context(), key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 8202, count, "开关关闭时不得调整")
+}
+
+// 开启后按 `实际 - 预留` 退回；且**只调整一次**（同一请求重复调用不会重复退回）。
+func TestAdjustReservedTPMRefundsTheDifferenceOnce(t *testing.T) {
+	c, ctrl := setupTPMAdjustEnv(t)
+	t.Setenv("APIGX_TPM_ADJUST_ENABLED", "true")
+
+	key := capacity.ChannelTPM(7702, capacity.MinuteWindow(time.Now()))
+	t.Cleanup(func() { _ = ctrl.Drop(context.Background(), key) })
+	// 预留 8202（prompt + 输出上限）
+	require.NoError(t, ctrl.IncrementWindow(t.Context(), key, 1_000_000, 8202, capacity.WindowTTL(time.Minute)))
+	storeTPMReservation(c, tpmReservation{windowKey: key, reserved: 8202, ttl: capacity.WindowTTL(time.Minute)})
+
+	// 实际只用 46 → 计数应变成 46（而不是 8202）
+	AdjustReservedTPM(c, 46)
+	count, err := ctrl.WindowCount(t.Context(), key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 46, count, "应按实际用量退回差额")
+
+	// 同一请求再调用一次：不得重复退回（否则计数会被减到 0 以下或凭空多出额度）
+	AdjustReservedTPM(c, 46)
+	count, err = ctrl.WindowCount(t.Context(), key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 46, count, "一次性记账：重复调用不得再次调整")
+}
+
+// 实际用量**高于**预留时不慌张：调整会让计数上升（窗口本来就该记住真实用量）。
+func TestAdjustReservedTPMHandlesUnderReservation(t *testing.T) {
+	c, ctrl := setupTPMAdjustEnv(t)
+	t.Setenv("APIGX_TPM_ADJUST_ENABLED", "true")
+
+	key := capacity.ChannelTPM(7703, capacity.MinuteWindow(time.Now()))
+	t.Cleanup(func() { _ = ctrl.Drop(context.Background(), key) })
+	require.NoError(t, ctrl.IncrementWindow(t.Context(), key, 1_000_000, 100, capacity.WindowTTL(time.Minute)))
+	storeTPMReservation(c, tpmReservation{windowKey: key, reserved: 100, ttl: capacity.WindowTTL(time.Minute)})
+
+	AdjustReservedTPM(c, 250) // 实际比预留多
+	count, err := ctrl.WindowCount(t.Context(), key)
+	require.NoError(t, err)
+	assert.EqualValues(t, 250, count, "窗口计数应反映真实用量（而不是低报）")
+}
+
+// 没有预留记录（例如未启用 TPM）时是空操作。
+func TestAdjustReservedTPMWithoutReservationIsNoop(t *testing.T) {
+	c, _ := setupTPMAdjustEnv(t)
+	t.Setenv("APIGX_TPM_ADJUST_ENABLED", "true")
+	AdjustReservedTPM(c, 100) // 不应 panic、也不应写任何东西
+	assert.True(t, true)
+}
