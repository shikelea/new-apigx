+      'duplicate',
+      'failed',
+    ])
+    expect(results[2]?.message).toBe('upstream unavailable')
+  })
+
+  it('返回 success=false 时按错误信息分类而不是当成成功', () => {
+    const results = classifyImportResults(
+      ['duplicate-model'],
+      [{ status: 'fulfilled', value: { success: false } }],
+      () => 'duplicate model'
+    )
+
+    expect(results[0]?.status).toBe('duplicate')
+  })
+})
