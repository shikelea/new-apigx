+For commercial licensing, please contact support@quantumnous.com
+*/
+export function parseKeyWeight(value: string): number | null {
+  const parsed = Number(value)
+  if (!Number.isInteger(parsed) || parsed < 1 || parsed > 1000) {
+    return null
+  }
+  return parsed
+}
