+export type ImportResult = {
+  model: string
+  status: 'created' | 'duplicate' | 'failed'
+  message?: string
+}
+
+export function classifyImportResults(
+  models: string[],
+  settled: PromiseSettledResult<{ success: boolean }>[],
+  errorMessage: (error: unknown) => string
+): ImportResult[] {
+  return settled.map((result, index) => {
+    const model = models[index] ?? ''
+    if (result.status === 'fulfilled' && result.value.success) {
+      return { model, status: 'created' }
+    }
+    const source = result.status === 'rejected' ? result.reason : result.value
+    const message = errorMessage(source)
+    const duplicate = /duplicate|already exists|已存在|重复/i.test(message)
+    return { model, status: duplicate ? 'duplicate' : 'failed', message }
+  })
+}
