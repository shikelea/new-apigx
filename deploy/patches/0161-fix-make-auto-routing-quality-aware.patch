--- a/apigx/channelpool/policy_source.go
+++ b/apigx/channelpool/policy_source.go
@@ -15,9 +15,9 @@ import (
 // # 为什么要有缓存
 //
 // 上限要在**每个请求**上解析（热路径），而策略存在数据库里。缓存按「分享渠道」维度存
-// 已经解析好的**策略链**，TTL 取短值；策略变更（分享者改上限）最长一个 TTL 后生效——
-// 这一点必须记录：容量上限不是「改了立刻全局生效」的配置，短暂延迟是可接受的，
-// 因为它只影响准入的宽严，不会造成记账错误。
+// 已经解析好的**策略链**，TTL 取短值；正式写接口在策略变更后调用
+// `InvalidatePolicyCache`，因此本进程内下一次请求立即读取新策略。TTL 只作为绕过正式写接口时的
+// 最终收敛边界，不能依赖它维持候选判断与最终原子预留的一致性。
 
 const policyCacheTTL = 30 * time.Second
 
