 		view.LatencyMsP50 = latencyWeightedSum / latencyWeight
@@ -321,8 +369,9 @@ func ResolveQualityView(db *gorm.DB, offeringID int64, windowKind int, at int64)
 	view.Insufficient = view.SampleCount < MinSamplesForQuality
