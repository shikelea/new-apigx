+++ b/apigx/model/migrate.go
@@ -0,0 +1,68 @@
+package apigxmodel
+
+import "gorm.io/gorm"
+
+// Migrate 创建或升级 APIGX 的全部领域表。
+//
+// 与底座 AutoMigrate 的关系（依据 `docs/stage0/schema-draft.md` §2.3）：
+//
+//   - **只增不改**：只创建/补充我们自己的 apigx_* 表，不触碰底座的任何表；
+//   - **幂等**：可重复执行，连续启动两次不产生额外的结构差异；
+//   - **三库同源**：不使用任何方言特性，SQLite / MySQL / PostgreSQL 走同一条代码路径；
+//   - **不建库级外键**：表间关系由 `FK` 列在应用层维护（schema-draft §6.1），
+//     因此没有创建顺序要求，也不需要级联。
+//
+// 调用点见 `docs/stage0/upstream-diff.md` 的 D-003（底座 model.migrateDB 之后）。
+func Migrate(db *gorm.DB) error {
+	if db == nil {
+		return gorm.ErrInvalidDB
+	}
+	return db.AutoMigrate(AllModels()...)
+}
+
+// AllModels 返回全部 APIGX 领域表模型。
+//
+// 顺序与契约要求无关（不建库级外键）；但**新增表必须同时加到这里**，
+// 否则该表不会随启动创建。表数量由 `migrate_test.go` 守住。
+func AllModels() []any {
+	return []any{
+		// §5.1–§5.13 身份、分享与授权（models_identity.go）
+		&UserProfile{},
+		&APIKey{},
+		&ShareGroup{},
+		&Channel{},
+		&UpstreamAccount{},
+		&UpstreamKey{},
+		&KeyModelCapability{},
+		&CanonicalModel{},
+		&ModelAlias{},
+		&ModelOffering{},
+		&AccessPolicy{},
+		&Grant{},
+		&Invite{},
+		// §5.14–§5.27 计价、计量、异步与运维（models_metering.go）
+		&FxRate{},
+		&PriceRule{},
+		&PriceRuleItem{},
+		&CapacityPolicy{},
+		&Reservation{},
+		&Request{},
+		&Attempt{},
+		&UsageEvent{},
+		&QualityBucket{},
+		&AsyncTask{},
+		&UpstreamObjectRef{},
+		&AuditEvent{},
+		&IdempotencyRecord{},
+		&PlatformSetting{},
+	}
+}
+
+// TableNamePrefix 供迁移与验收脚本筛选 APIGX 自己的表（避免与底座表混淆）。
+const TableNamePrefix = TablePrefix
+
+// ExpectedTableCount 是当前冻结设计的表数量（schema-draft §5.1–§5.27，共 27 张）。
+//
+// 这是一个**契约常量**：新增表时必须同时调整它，并让 migrate_test.go 的断言继续成立；
+// 这样「漏加迁移」会立刻变成测试失败，而不是静默少建一张表。
+const ExpectedTableCount = 27
diff --git a/apigx/model/migrate_matrix_test.go b/apigx/model/migrate_matrix_test.go
new file mode 100644
index 0000000..1aa291f
--- /dev/null
+++ b/apigx/model/migrate_matrix_test.go
@@ -0,0 +1,87 @@
+package apigxmodel
+
+import (
+	"os"
+	"testing"
+
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/mysql"
+	"gorm.io/driver/postgres"
+	"gorm.io/gorm"
+)
+
+// 三库兼容矩阵（底座 AGENTS.md 硬要求：SQLite / MySQL ≥ 5.7.8 / PostgreSQL ≥ 9.6
+// 必须**各自在真实实例上**验证；单库通过不算通过）。
+//
+// 由环境变量驱动，未配置的方言会**明确跳过并打印原因**，不会静默略过：
+//
+//	APIGX_TEST_PG_DSN    postgres://user:pass@host:port/db?sslmode=disable
+//	APIGX_TEST_MYSQL_DSN user:pass@tcp(host:port)/db?charset=utf8mb4&parseTime=True&loc=UTC
+//
+// 每种方言都做两件事：
+//  1. 在**全新库**上迁移，并断言建出 ExpectedTableCount 张 apigx_ 表；
+//  2. **连续迁移两次**，断言第二次无错且表集合不变（幂等）。
+//
+// 「从底座旧库升级」的场景由外部脚本驱动：同一个测试直接指向底座已迁移过的库即可
+// （此时 apigx_ 表是新增的，底座表原样保留）。
+func TestMigrateMatrixOnConfiguredDialects(t *testing.T) {
+	t.Run("sqlite", func(t *testing.T) {
+		db := newSQLiteDB(t)
+		require.NoError(t, Migrate(db))
+		assert.Len(t, apigxTableNames(t, db), ExpectedTableCount)
+		require.NoError(t, Migrate(db), "第二次迁移必须幂等")
+		assert.Len(t, apigxTableNames(t, db), ExpectedTableCount)
+	})
+
+	t.Run("postgres", func(t *testing.T) {
+		dsn := os.Getenv("APIGX_TEST_PG_DSN")
+		if dsn == "" {
+			t.Skip("未设置 APIGX_TEST_PG_DSN：PostgreSQL 矩阵未执行（不允许当作通过）")
+		}
+		db, err := gorm.Open(postgres.Open(dsn), &gorm.Config{})
+		require.NoError(t, err, "连接 PostgreSQL 失败")
+		assertPostgresMatrix(t, db)
+	})
+
+	t.Run("mysql", func(t *testing.T) {
+		dsn := os.Getenv("APIGX_TEST_MYSQL_DSN")
+		if dsn == "" {
+			t.Skip("未设置 APIGX_TEST_MYSQL_DSN：MySQL 矩阵未执行（不允许当作通过）")
+		}
+		db, err := gorm.Open(mysql.Open(dsn), &gorm.Config{})
+		require.NoError(t, err, "连接 MySQL 失败")
+		require.NoError(t, Migrate(db))
+		require.NoError(t, Migrate(db), "第二次迁移必须幂等")
+		// MySQL 与 PostgreSQL 的表清单都用 information_schema 查
+		assert.Len(t, informationSchemaApigxTables(t, db, "table_name"), ExpectedTableCount)
+	})
+}
+
+func assertPostgresMatrix(t *testing.T, db *gorm.DB) {
+	t.Helper()
+	require.NoError(t, Migrate(db))
+	assert.Len(t, informationSchemaApigxTables(t, db, "table_name"), ExpectedTableCount)
+	require.NoError(t, Migrate(db), "第二次迁移必须幂等")
+	assert.Len(t, informationSchemaApigxTables(t, db, "table_name"), ExpectedTableCount)
+}
+
+// informationSchemaApigxTables 通过 information_schema 统计 apigx_ 表，
+// 同时适用于 PostgreSQL 与 MySQL（SQLite 用 sqlite_master，见 apigxTableNames）。
+func informationSchemaApigxTables(t *testing.T, db *gorm.DB, column string) []string {
+	t.Helper()
+	var names []string
+	// 只查当前库的当前 schema；用参数绑定避免拼接
+	query := "SELECT " + column + " FROM information_schema.tables WHERE table_schema = current_schema() AND substr(" + column + ", 1, 6) = ?"
+	if err := db.Raw(query, TablePrefix).Scan(&names).Error; err != nil {
+		// MySQL 的 current_schema() 等价于 DATABASE()，若上面失败则回退
+		fallback := "SELECT " + column + " FROM information_schema.tables WHERE table_schema = DATABASE() AND substr(" + column + ", 1, 6) = ?"
+		require.NoError(t, db.Raw(fallback, TablePrefix).Scan(&names).Error)
+	}
+	return names
+}
+
+// 说明：sqlite 驱动在此文件被引用是为了保证 matrix 测试在只跑本文件时也能编译；
+// 真正的 SQLite 用例在 migrate_test.go。
+var _ = sqlite.Open
diff --git a/apigx/model/migrate_test.go b/apigx/model/migrate_test.go
new file mode 100644
index 0000000..a7d7bf6
--- /dev/null
+++ b/apigx/model/migrate_test.go
@@ -0,0 +1,96 @@
+package apigxmodel
+
+import (
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+// apigxTableNames 从 SQLite 里取出所有 apigx_ 前缀的表名。
+// 用 substr 而不是 LIKE：LIKE 里 '_' 是通配符，会把 apigxX… 也匹配进来。
+func apigxTableNames(t *testing.T, db *gorm.DB) []string {
+	t.Helper()
+	var names []string
+	err := db.Raw("SELECT name FROM sqlite_master WHERE type = 'table' AND substr(name, 1, 6) = ?", TablePrefix).Scan(&names).Error
+	require.NoError(t, err)
+	return names
+}
+
+func newSQLiteDB(t *testing.T) *gorm.DB {
+	t.Helper()
+	// 用文件库而不是内存库：内存库每条连接一份，无法验证「连续两次迁移」的幂等性。
+	dsn := filepath.Join(t.TempDir(), "apigx_migrate_test.db")
+	db, err := gorm.Open(sqlite.Open(dsn), &gorm.Config{})
+	require.NoError(t, err)
+	// Windows 上必须显式关闭底层连接，否则 TempDir 清理会因文件被占用而失败。
+	sqlDB, err := db.DB()
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = sqlDB.Close() })
+	return db
+}
+
+// TestMigrateCreatesAllDomainTables 守住「设计里有多少张表，迁移就必须建多少张」。
+// 漏加一张表会让本用例失败，而不是让问题在运行时才暴露。
+func TestMigrateCreatesAllDomainTables(t *testing.T) {
+	db := newSQLiteDB(t)
+
+	require.NoError(t, Migrate(db))
+
+	names := apigxTableNames(t, db)
+	assert.Len(t, names, ExpectedTableCount, "建表数量与冻结设计不一致：%v", names)
+	assert.Len(t, AllModels(), ExpectedTableCount, "AllModels 与 ExpectedTableCount 不一致")
+}
+
+// TestMigrateIsIdempotentOnSQLite 验证连续两次迁移不报错、且不改变表集合。
+// 依据底座 AGENTS.md：schema/迁移改动必须验证幂等性（要求连续启动两次）。
+func TestMigrateIsIdempotentOnSQLite(t *testing.T) {
+	db := newSQLiteDB(t)
+
+	require.NoError(t, Migrate(db))
+	first := apigxTableNames(t, db)
+
+	require.NoError(t, Migrate(db), "第二次迁移必须无错（幂等）")
+	second := apigxTableNames(t, db)
+
+	assert.ElementsMatch(t, first, second, "两次迁移后的表集合必须一致")
+	assert.Len(t, second, ExpectedTableCount)
+}
+
+// TestMigrateRejectsNilDB 保证误用（例如迁移前 DB 未初始化）会明确报错。
+func TestMigrateRejectsNilDB(t *testing.T) {
+	require.Error(t, Migrate(nil))
+}
+
+// TestModelFieldTypesArePortable 是本项目的「三库可移植」守门测试。
+//
+// schema-draft §3.2 把字段类型收敛到极小的集合（int64 / int / string / bool / gorm.DeletedAt），
+// 正是为了让 SQLite / MySQL / PostgreSQL 生成等价列类型。一旦有人在模型里引入
+// time.Time、float64、decimal、指针类型或自定义类型，本用例立刻失败——
+// 这类字段在不同驱动上的 Scanner/Valuer 行为会分叉（schema-draft §3.2 已说明为何金额用 int64 micro 单位）。
+func TestModelFieldTypesArePortable(t *testing.T) {
+	deletedAtType := reflect.TypeOf(gorm.DeletedAt{})
+	allowed := map[reflect.Kind]bool{
+		reflect.Int64:  true, // ID / FK / BIGINT / MICRO / TS
+		reflect.Int:    true, // INT / ENUM
+		reflect.String: true, // STR / TEXT / HASH64 / CUR3
+		reflect.Bool:   true, // BOOL
+	}
+
+	for _, m := range AllModels() {
+		modelType := reflect.TypeOf(m).Elem()
+		for i := 0; i < modelType.NumField(); i++ {
+			field := modelType.Field(i)
+			if field.Type == deletedAtType {
+				continue // 软删除列是唯一例外，底座同样使用
+			}
+			assert.True(t, allowed[field.Type.Kind()],
+				"%s.%s 的类型是 %s，不在可移植集合内（只允许 int64/int/string/bool/gorm.DeletedAt）",
+				modelType.Name(), field.Name, field.Type)
+		}
+	}
+}
diff --git a/apigx/model/models_identity.go b/apigx/model/models_identity.go
new file mode 100644
index 0000000..1c08c9b
--- /dev/null
+++ b/apigx/model/models_identity.go
@@ -0,0 +1,571 @@
+// 本文件对应 `docs/stage0/schema-draft.md` §5.1–§5.13，字段与约束依据该文档，
+// 不得自行增删字段。
+//
+// 包名与硬约束（三库可移植、类型别名 → GORM tag 对照表、四态枚举、墓碑软删除模板）
+// 见同包的 `base.go` 包注释；本文件不再重复，字段 tag 一律按该对照表书写。
+//
+// 本文件只描述表结构，不含 SQL、不建库级外键约束（§6.1）、不写 CHECK（§3.3），
+// 所有跨表一致性校验落在 Go 服务端。
+package apigxmodel
+
+import (
+	"gorm.io/gorm"
+)
+
+// UserProfile 承载平台独有的用户属性，与底座 `users`（`new-api/model/user.go:79-115`）一对一。
+// 不新建用户表，不复制身份、密码、邮箱、会话（CODE_STYLE.md 第 9 条「不另起第二套用户系统」）。
+//
+// schema-draft §5.1
+type UserProfile struct {
+	// UserID 与底座 users.id 同值；主键即底座用户 ID，因此不自增。
+	UserID int64 `gorm:"primaryKey;autoIncrement:false"`
+	// TrustLevel 信任级别：0=待审核 / 1=普通 / 2=可信分享者 / 3=管理员指定。
+	TrustLevel int `gorm:"type:int;not null"`
+	// SharingEnabled 是否允许发布分享资源（审核策略开关）。
+	SharingEnabled bool `gorm:"not null"`
+	// DefaultRouteMode Key 未指定时的默认路由偏好：pinned/latency/throughput/reliability/auto。
+	DefaultRouteMode string `gorm:"size:16;not null;default:''"`
+	// DefaultAllowFallback 默认是否允许「指定来源失败后自动回退」（§9.1）。
+	DefaultAllowFallback bool `gorm:"not null"`
+	// BudgetLimitMode 用户级每日 USD 估算预算的模式（四态，§3.3）。
+	BudgetLimitMode int `gorm:"type:int;not null"`
+	// BudgetLimitMicro 用户级每日预算额度，micro-USD；仅 mode=4 时有效。
+	BudgetLimitMicro int64 `gorm:"bigint;not null;default:0"`
+	// FreezeState 冻结状态：0=正常 / 1=管理员封禁 / 2=风控冻结；与底座 users.status 并存，不替代它。
+	FreezeState int `gorm:"type:int;not null"`
+	// FrozenAt 冻结时间，UTC epoch 秒；0=未冻结。
+	FrozenAt int64 `gorm:"bigint;not null;default:0"`
+	// FrozenReason 冻结原因（脱敏，不含凭据）。
+	FrozenReason string `gorm:"size:255;not null;default:''"`
+	// CreatedAt 创建时间，UTC epoch 秒。
+	CreatedAt int64 `gorm:"bigint;not null;default:0"`
+	// UpdatedAt 最近更新时间，UTC epoch 秒。
+	UpdatedAt int64 `gorm:"bigint;not null;default:0"`
+	// AliveFlag 软删除墓碑列：0=存活，软删除时置为本行 ID（§3.5）。
+	AliveFlag int64 `gorm:"bigint;not null;default:0"`
+	// DeletedAt 软删除时间；用户删除后本行保留 user_id 供历史引用，不物理删。
+	DeletedAt gorm.DeletedAt `gorm:"index:idx_apigx_userprofile_del"`
+}
+
+// TableName 返回表名。
+func (UserProfile) TableName() string { return TablePrefix + "user_profiles" }
+
+// APIKey 是平台 API Key 的权威记录：持有者、可访问范围、默认策略、额度与到期时间。
+//
+// schema-draft §5.2
+type APIKey struct {
+	// ID 稳定内部 ID（Grant、请求归属、轮询索引都引用它）。
+	ID int64 `gorm:"primaryKey"`
+	// UserID 持有者，底座 users.id。
+	UserID int64 `gorm:"bigint;not null;default:0"`
+	// TokenID 底座 tokens.id（影子令牌）；唯一，永不复用。
+	TokenID int64 `gorm:"bigint;not null;default:0"`
+	// Name 展示名（可重名，不作授权依据，CODE_STYLE.md 第 1 条）。
+	Name string `gorm:"size:64;not null;default:''"`
+	// KeyPrefix 明文前 8 位，仅供界面识别；不含完整凭据。
+	KeyPrefix string `gorm:"size:12;not null;default:''"`
+	// KeyHash SHA-256(secret) 十六进制，不可恢复；天然不含 '-'（§2.4）。
+	KeyHash string `gorm:"type:char(64);uniqueIndex:idx_apigx_apikey_hash"`
+	// ScopeMode 可访问范围模式：0=全部已授权供给 / 1=白名单 / 2=固定单一来源（硬限制）。
+	ScopeMode int `gorm:"type:int;not null"`
+	// PinnedOfferingID scope_mode=2 时必填（非 0），指向 apigx_model_offerings.id。
+	PinnedOfferingID int64 `gorm:"bigint;not null;default:0"`
+	// AllowedModelIDs JSON 数组：允许的 apigx_canonical_models.id（scope_mode=1 用）；TEXT 列 + common.Marshal。
+	AllowedModelIDs string `gorm:"type:text"`
+	// AllowedOwnerUserIDs JSON 数组：允许的分享者（可信分享者限定，§10.3）。
+	AllowedOwnerUserIDs string `gorm:"type:text"`
+	// AllowFallback 是否允许回退；硬限制，请求参数不能放宽（§9.1）。
+	AllowFallback bool `gorm:"not null"`
+	// DefaultRouteMode 默认路由偏好（偏好，不是硬限制）。
+	DefaultRouteMode string `gorm:"size:16;not null;default:''"`
+	// RateLimitMode Key 级 RPM 限制模式（四态，§3.3）。
+	RateLimitMode int `gorm:"type:int;not null"`
+	// RateLimitRPM Key 级每分钟请求数上限；仅 mode=4 时有效。
