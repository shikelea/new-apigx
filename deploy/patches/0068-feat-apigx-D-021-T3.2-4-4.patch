+			"quota": entry.Quota,
 			// 底座以「quota」为记账单位；这里换算成微美元（1e-6 USD）便于使用者理解。
 			// 换算率用底座的 QuotaPerUnit（与计费同一来源，不自己写死）。
 			"cost_micro_usd": quotaToMicroUSD(entry.Quota),
diff --git a/relay/helper/openai_image_request_test.go b/relay/helper/openai_image_request_test.go
index 812a933..2abeea6 100644
--- a/relay/helper/openai_image_request_test.go
+++ b/relay/helper/openai_image_request_test.go
@@ -239,3 +239,38 @@ func TestGetAndValidOpenAIImageRequestNBounds(t *testing.T) {
 		require.Contains(t, err.Error(), boundErr)
 	})
 }
+
+// 尺寸约束：语法与范围（阶段 3 用真实上游发现：上游会对非法尺寸**默默出图**，
+// 于是错误要到出图后才发现，而那时已经计费）。
+func TestValidateImageSize(t *testing.T) {
+	cases := []struct {
+		size    string
+		wantErr bool
+	}{
+		{"1024x1024", false},
+		{"512x512", false},
+		{"1792x1024", false},
+		{"1x1", false},
+		{"4096x4096", false},
+		{"", false},         // 空串 = 用上游默认
+		{"999x999", false},  // 合法语法（上游支持与否属"支持范围"，不在这里判定）
+		{"abc", true},       // 缺分隔符
+		{"1024", true},      // 缺高度
+		{"1024x", true},     // 高度为空
+		{"x1024", true},     // 宽度为空
+		{"0x1024", true},    // 下界
+		{"1024x0", true},    // 下界
+		{"5000x5000", true}, // 上界
+		{"1024X1024", true}, // 大写 X 不接受（避免与上游解析差异）
+	}
+	for _, tc := range cases {
+		t.Run(tc.size, func(t *testing.T) {
+			err := validateImageSize(tc.size)
+			if tc.wantErr {
+				require.Error(t, err, "size=%q 应当被拒绝", tc.size)
+			} else {
+				require.NoError(t, err, "size=%q 应当被接受", tc.size)
+			}
+		})
+	}
+}
diff --git a/relay/helper/valid_request.go b/relay/helper/valid_request.go
index 19eaf4d..4eca170 100644
--- a/relay/helper/valid_request.go
+++ b/relay/helper/valid_request.go
@@ -273,6 +273,19 @@ func GetAndValidOpenAIImageRequest(c *gin.Context, relayMode int) (*dto.ImageReq
 		}
 	}
 
+	// **尺寸约束**：放在这里而不是各适配器里——数量 `n` 也是在这一处校验的，
+	// 同一类约束散到两处早晚会不一致。
+	//
+	// 为什么需要它（阶段 3 用真实上游发现）：真实的 `qwen-image-2.0` 对
+	// `size=999x999` 会**默默接受**并出图，于是"不支持的尺寸"要到出图后才发现——那时已经计费。
+	// 这里只做**语法与范围**校验（`宽x高`，各边 1..4096），不预先假定某家上游支持哪些档位；
+	// 某家具体支持哪些尺寸属"支持范围"，应当记录与展示，而不是在这里硬编码。
+	if imageRequest.Size != "" {
+		if err := validateImageSize(imageRequest.Size); err != nil {
+			return nil, err
+		}
+	}
+
 	// Provider parameters can override the top-level count. Validate before
 	// pricing so malformed multipliers return a client error, not a pricing
 	// failure after reservation has started.
@@ -410,3 +423,33 @@ func GetAndValidateGeminiBatchEmbeddingRequest(c *gin.Context) (*dto.GeminiBatch
 	}
 	return request, nil
 }
+
+// maxImageSizeEdge 是单边像素的允许上限。取 4096 是**语法与范围**的护栏
+// （防止明显离谱的输入进入计费），不代表任何上游的实际支持档位。
+const maxImageSizeEdge = 4096
+
+// validateImageSize 校验 `宽x高` 形式的尺寸参数。
+//
+// 只接受十进制整数与单个 `x` 分隔符；两侧必须落在 1..maxImageSizeEdge。
+// 空串放行（表示使用上游默认尺寸）。
+func validateImageSize(size string) error {
+	if strings.TrimSpace(size) == "" {
+		return nil // 空串 = 使用上游默认尺寸；调用处也会跳过，这里再兜一次保证函数自洽
+	}
+	parts := strings.Split(size, "x")
+	if len(parts) != 2 {
+		return fmt.Errorf("size must look like WIDTHxHEIGHT, got %q", size)
+	}
+	width, err := strconv.Atoi(strings.TrimSpace(parts[0]))
+	if err != nil {
+		return fmt.Errorf("size width must be an integer, got %q", parts[0])
+	}
+	height, err := strconv.Atoi(strings.TrimSpace(parts[1]))
+	if err != nil {
+		return fmt.Errorf("size height must be an integer, got %q", parts[1])
+	}
+	if width < 1 || width > maxImageSizeEdge || height < 1 || height > maxImageSizeEdge {
+		return fmt.Errorf("size must be between 1 and %d on each side, got %dx%d", maxImageSizeEdge, width, height)
+	}
+	return nil
+}
