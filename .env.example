# APIGX 本地开发环境变量模板
#
# 复制为 .env（.env 已在 .gitignore 中，禁止提交）
#
# PostgreSQL：本地开发默认用仓库内的独立实例（不碰系统服务）
#   数据目录 .toolchain/pgdata，监听 127.0.0.1:5433，角色 apigx，库 apigx_dev，
#   密码为本机开发默认值（仅监听回环）。管理：.\tools\dev\pg.ps1 start|status|stop|psql
#   备选：系统服务实例 postgresql-x64-18（127.0.0.1:5432），用 tools/dev/init-db.ps1 初始化。
DATABASE_URL=postgres://apigx:apigx_dev@127.0.0.1:5433/apigx_dev?sslmode=disable

# Redis：本地便携版，配置见 deploy/local/redis.conf
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# 平台配置（计划书 §12 开发基线，先占位，阶段 1 接入）
APIGX_ENV=development
APIGX_DEFAULT_CURRENCY=USD
APIGX_DAILY_RESET_TZ=Asia/Shanghai

# 上游凭据加密主密钥：仅本地开发用，必须与数据库分离保存，禁止提交（计划书 §10.3）
APIGX_SECRET_KEY=CHANGE_ME_LOCAL_DEV_ONLY

# 出网：境外站点需要本地代理；Git 已按仓库配置 http.https://github.com/.proxy
APIGX_PROXY=http://127.0.0.1:7897
