# APIGX 本地开发环境变量模板
#
# 复制为 new-api/.env（.env 已在 .gitignore 中，禁止提交）。New API 只读取
# 进程工作目录下的 .env；容器部署也可直接注入同名环境变量。
#
# PostgreSQL：本地开发默认用仓库内的独立实例（不碰系统服务）
#   数据目录 .toolchain/pgdata，监听 127.0.0.1:5433，角色 apigx，库 apigx_dev，
#   密码为本机开发默认值（仅监听回环）。管理：.\tools\dev\pg.ps1 start|status|stop|psql
#   备选：系统服务实例 postgresql-x64-18（127.0.0.1:5432），用 tools/dev/init-db.ps1 初始化。
SQL_DSN=postgres://apigx:apigx_dev@127.0.0.1:5433/apigx_dev?sslmode=disable

# Redis：本地便携版，配置见 deploy/local/redis.conf
REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# APIGX 共享资源产品模式。开启后启动自检会拒绝缺失的安全、计量、容量和路由开关。
# 若只把本 fork 当作通用 New API 使用，可设 false；APIGX 正式部署必须为 true。
APIGX_SHARED_MODE=true
APIGX_ENV=development
APIGX_DEFAULT_CURRENCY=USD
APIGX_DAILY_RESET_TZ=Asia/Shanghai

# 免费共享：允许无充值余额调用，但保留平台 Key 额度、用量和美元估算成本。
APIGX_USAGE_ONLY=true

# 指定来源权限、容量、多 Key 健康、质量采集、熔断和路由策略。
APIGX_SOURCE_GUARD_ENABLED=true
APIGX_CAPACITY_ENABLED=true
APIGX_KEY_STATS_ENABLED=true
APIGX_QUALITY_STATS_ENABLED=true
APIGX_BREAKER_ENABLED=true
APIGX_ROUTE_STRATEGY_ENABLED=true
APIGX_TPM_ADJUST_ENABLED=true

# 0 表示使用每个分享渠道自己的策略；需要全局兜底时填写正整数。
APIGX_CHANNEL_CONCURRENCY_LIMIT=0
APIGX_TOKEN_CONCURRENCY_LIMIT=0
APIGX_USER_CONCURRENCY_LIMIT=0
APIGX_UPSTREAM_KEY_CONCURRENCY_LIMIT=0
APIGX_UPSTREAM_ACCOUNT_CONCURRENCY_LIMIT=0
APIGX_CHANNEL_RPM_LIMIT=0
APIGX_CHANNEL_TPM_LIMIT=0
APIGX_DAILY_BUDGET_MICRO=0

# 上游凭据加密主密钥：仅本地开发用，必须与数据库分离保存，禁止提交（计划书 §10.3）
APIGX_SECRET_KEY=CHANGE_ME_LOCAL_DEV_ONLY

# New API 会话签名密钥；正式部署必须替换为独立随机值。
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SESSION_SECRET

# 出网：境外站点需要本地代理；Git 已按仓库配置 http.https://github.com/.proxy
APIGX_PROXY=http://127.0.0.1:7897
