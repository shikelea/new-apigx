# 本地便携工具链（Go、Redis 等，由 tools/dev/bootstrap.ps1 下载解压）
/.toolchain/

# APIGX 底座源码已作为 tracked subtree 纳入本仓库，保留完整 fork 历史。
# 依赖与构建产物仍由 new-api/.gitignore、node_modules/dist 规则过滤。

# 依赖与构建产物
node_modules/
dist/
build/
target/
out/
*.hap

# 环境与敏感文件
.env
.env.*
!.env.example
*.pem
*.key
local.properties

# IDE 与编辑器
.vscode/
.idea/
*.swp

# 代码库索引与缓存（skill 明确禁止提交）
.codebase-memory/

# 运行期数据与日志
*.log
logs/
tmp/

# Agent 团队的本地状态（任务看板产物）
/.agent-teams/

# 本地浏览器与验证输出
/.playwright-cli/
/output/

# 参照实现（meow-llm-detector）的本地克隆，只用来对照行为，不入库
/meow-reference/

# 本地开发流程与任务记录
/whisper-note-dev-flow/
/apigx.env
